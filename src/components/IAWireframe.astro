---
// Annotated wireframe exposing the IA decision behind the CGM dashboard.
// Greyscale, deliberately low-fidelity — structure and reasoning, not polish.
---

<section class="iawire">
  <p class="iawire__eyebrow">The structure behind it</p>
  <p class="iawire__intro">Before the screens, the skeleton. Three regions, metered by how deep each reader goes.</p>

  <div class="iawire__layout">
    <!-- Left annotation (toggle) -->
    <div class="iawire__note iawire__note--left iawire__note--toggle">
      <div class="iawire__note-inner">
        <p class="iawire__note-text">One tap between today's answer and 15-day trends. The Seeker lands on "am I okay today"; the Changer drops into the week — neither wades through the other's screen.</p>
      </div>
    </div>

    <!-- Phone wireframe (inline SVG) -->
    <div class="iawire__phone-wrap">
      <svg class="iawire__phone" viewBox="0 0 320 620" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Low-fidelity wireframe of the CGM dashboard showing three regions: a Daily/Cumulative toggle at top, the glanceable core in the middle, and the walled-off Advanced section below">
        <!-- Phone shell -->
        <rect x="4" y="4" width="312" height="612" rx="32" fill="#fafafa" stroke="#d0d0d0" stroke-width="1.5"/>

        <!-- Status bar -->
        <rect x="20" y="16" width="40" height="6" rx="3" fill="#ccc"/>
        <rect x="140" y="14" width="40" height="8" rx="4" fill="#bbb"/>
        <rect x="260" y="16" width="40" height="6" rx="3" fill="#ccc"/>

        <!-- ─── REGION 1: Toggle ─── -->
        <g class="iawire__region iawire__region--toggle">
          <rect x="40" y="42" width="240" height="36" rx="18" fill="none" stroke="#aaa" stroke-width="1.2" stroke-dasharray="4 3"/>
          <rect x="42" y="44" width="118" height="32" rx="16" fill="#ddd"/>
          <text x="101" y="64" text-anchor="middle" font-size="11" font-weight="600" fill="#555" font-family="system-ui, sans-serif">Daily</text>
          <text x="220" y="64" text-anchor="middle" font-size="11" font-weight="500" fill="#999" font-family="system-ui, sans-serif">Cumulative</text>
        </g>

        <!-- Arrow from toggle to left annotation -->
        <line class="iawire__arrow iawire__arrow--toggle" x1="40" y1="60" x2="4" y2="60" stroke="#aaa" stroke-width="1.2" marker-end="url(#arrowLeft)"/>

        <!-- ─── REGION 2: Glanceable core ─── -->
        <g class="iawire__region iawire__region--core">
          <!-- Current glucose box -->
          <rect x="40" y="98" width="240" height="72" rx="8" fill="none" stroke="#bbb" stroke-width="1"/>
          <text x="60" y="118" font-size="9" fill="#999" font-family="system-ui, sans-serif" text-transform="uppercase" letter-spacing="0.5">CURRENT GLUCOSE</text>
          <text x="60" y="150" font-size="32" font-weight="700" fill="#888" font-family="system-ui, sans-serif">124</text>
          <text x="112" y="150" font-size="12" fill="#aaa" font-family="system-ui, sans-serif">mg/dL</text>
          <circle cx="252" cy="134" r="16" fill="none" stroke="#ccc" stroke-width="1"/>
          <text x="252" y="138" text-anchor="middle" font-size="8" fill="#aaa" font-family="system-ui, sans-serif">IN</text>

          <!-- Daily average / time in range row -->
          <rect x="40" y="182" width="115" height="54" rx="8" fill="none" stroke="#bbb" stroke-width="1"/>
          <text x="50" y="198" font-size="8" fill="#aaa" font-family="system-ui, sans-serif">DAILY AVG</text>
          <rect x="50" y="206" width="60" height="8" rx="4" fill="#ddd"/>
          <text x="50" y="226" font-size="14" font-weight="600" fill="#888" font-family="system-ui, sans-serif">118 mg/dL</text>

          <rect x="165" y="182" width="115" height="54" rx="8" fill="none" stroke="#bbb" stroke-width="1"/>
          <text x="175" y="198" font-size="8" fill="#aaa" font-family="system-ui, sans-serif">TIME IN RANGE</text>
          <rect x="175" y="206" width="75" height="8" rx="4" fill="#ccc"/>
          <text x="175" y="226" font-size="14" font-weight="600" fill="#888" font-family="system-ui, sans-serif">76%</text>

          <!-- Graph placeholder -->
          <rect x="40" y="248" width="240" height="100" rx="8" fill="none" stroke="#bbb" stroke-width="1"/>
          <text x="160" y="268" text-anchor="middle" font-size="9" fill="#aaa" font-family="system-ui, sans-serif">DAY GLUCOSE GRAPH</text>
          <!-- Fake graph line -->
          <polyline points="60,320 90,310 120,325 150,305 180,315 210,290 240,308 260,300" fill="none" stroke="#ccc" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <line x1="60" y1="338" x2="260" y2="338" stroke="#ddd" stroke-width="0.8"/>
          <text x="60" y="346" font-size="7" fill="#ccc" font-family="system-ui, sans-serif">12AM</text>
          <text x="155" y="346" text-anchor="middle" font-size="7" fill="#ccc" font-family="system-ui, sans-serif">12PM</text>
          <text x="260" y="346" text-anchor="end" font-size="7" fill="#ccc" font-family="system-ui, sans-serif">NOW</text>
        </g>

        <!-- Arrow from core to right annotation -->
        <line class="iawire__arrow iawire__arrow--core" x1="280" y1="220" x2="316" y2="220" stroke="#aaa" stroke-width="1.2" marker-end="url(#arrowRight)"/>

        <!-- ─── DIVIDER / WALL ─── -->
        <line x1="30" y1="380" x2="290" y2="380" stroke="#999" stroke-width="1.5" stroke-dasharray="6 4"/>
        <rect x="108" y="371" width="104" height="18" rx="9" fill="#f0f0f0" stroke="#bbb" stroke-width="0.8"/>
        <text x="160" y="383" text-anchor="middle" font-size="8" font-weight="600" fill="#888" font-family="system-ui, sans-serif" letter-spacing="0.5">ADVANCED METRICS</text>

        <!-- ─── REGION 3: Advanced / walled-off ─── -->
        <g class="iawire__region iawire__region--advanced">
          <rect x="40" y="400" width="240" height="180" rx="8" fill="none" stroke="#bbb" stroke-width="1" stroke-dasharray="4 3"/>
          <rect x="40" y="400" width="240" height="180" rx="8" fill="rgba(0,0,0,0.015)"/>

          <text x="60" y="424" font-size="9" fill="#999" font-family="system-ui, sans-serif">HbA1c ESTIMATE (GMI)</text>
          <rect x="60" y="430" width="100" height="10" rx="5" fill="#ddd"/>

          <line x1="60" y1="456" x2="260" y2="456" stroke="#e0e0e0" stroke-width="0.8"/>

          <text x="60" y="476" font-size="9" fill="#999" font-family="system-ui, sans-serif">GLUCOSE VARIABILITY</text>
          <rect x="60" y="482" width="80" height="10" rx="5" fill="#ddd"/>

          <line x1="60" y1="508" x2="260" y2="508" stroke="#e0e0e0" stroke-width="0.8"/>

          <text x="60" y="528" font-size="9" fill="#999" font-family="system-ui, sans-serif">AGP REPORT</text>
          <rect x="60" y="536" width="180" height="28" rx="6" fill="none" stroke="#ddd" stroke-width="0.8"/>
          <polyline points="70,558 100,548 130,554 160,544 190,550 220,546 230,552" fill="none" stroke="#ccc" stroke-width="1" stroke-linecap="round"/>
        </g>

        <!-- Arrow from advanced to left annotation (accent) -->
        <line class="iawire__arrow iawire__arrow--advanced" x1="40" y1="490" x2="4" y2="490" stroke="#E75F38" stroke-width="1.8" marker-end="url(#arrowAccent)"/>

        <!-- Arrow markers -->
        <defs>
          <marker id="arrowLeft" viewBox="0 0 8 8" refX="1" refY="4" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M8,1 L1,4 L8,7" fill="none" stroke="#aaa" stroke-width="1.2"/>
          </marker>
          <marker id="arrowRight" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M0,1 L7,4 L0,7" fill="none" stroke="#aaa" stroke-width="1.2"/>
          </marker>
          <marker id="arrowAccent" viewBox="0 0 8 8" refX="1" refY="4" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M8,1 L1,4 L8,7" fill="none" stroke="#E75F38" stroke-width="1.5"/>
          </marker>
        </defs>
      </svg>
    </div>

    <!-- Right annotation (glanceable core) -->
    <div class="iawire__note iawire__note--right iawire__note--core">
      <div class="iawire__note-inner">
        <p class="iawire__note-text">The glanceable core everyone shares — current glucose, average, time in range.</p>
      </div>
    </div>

    <!-- Left annotation (advanced — emphasized) -->
    <div class="iawire__note iawire__note--left iawire__note--advanced">
      <div class="iawire__note-inner iawire__note-inner--accent">
        <p class="iawire__note-text">Deliberately separated. The clinical team withholds scary metrics to avoid panic — so AGP and variability live here, for the Diabetic and the coach, not on the everyday user's home screen.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .iawire {
    width: min(60rem, 92vw);
    margin: var(--space-3xl) 50%;
    transform: translateX(-50%);
  }

  .iawire__eyebrow {
    font-size: var(--font-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-xs);
  }

  .iawire__intro {
    font-size: var(--font-md);
    line-height: 1.5;
    color: var(--ink);
    max-width: 40rem;
    margin-bottom: var(--space-2xl);
  }

  .iawire__layout {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0;
    align-items: start;
    position: relative;
  }

  .iawire__phone-wrap {
    grid-column: 2;
    grid-row: 1 / 3;
    width: 280px;
  }

  .iawire__phone {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Annotations */
  .iawire__note {
    display: flex;
    padding: var(--space-md);
  }

  .iawire__note--left {
    grid-column: 1;
    justify-content: flex-end;
    padding-right: var(--space-lg);
  }

  .iawire__note--right {
    grid-column: 3;
    justify-content: flex-start;
    padding-left: var(--space-lg);
  }

  .iawire__note--toggle {
    grid-row: 1;
    align-self: start;
    margin-top: 1.5rem;
  }

  .iawire__note--core {
    grid-row: 1;
    align-self: center;
    margin-top: 12rem;
  }

  .iawire__note--advanced {
    grid-row: 2;
    align-self: start;
    margin-top: -2rem;
  }

  .iawire__note-inner {
    max-width: 16rem;
    padding: var(--space-md);
    border-left: 2px solid var(--hairline);
    background: rgba(0, 0, 0, 0.02);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .iawire__note--right .iawire__note-inner {
    border-left: none;
    border-right: 2px solid var(--hairline);
    border-radius: var(--radius-md) 0 0 var(--radius-md);
  }

  .iawire__note-inner--accent {
    border-left-color: var(--accent);
    border-left-width: 3px;
    background: rgba(231, 95, 56, 0.04);
  }

  .iawire__note-text {
    font-size: var(--font-sm);
    line-height: 1.55;
    color: var(--muted);
  }

  .iawire__note-inner--accent .iawire__note-text {
    color: var(--ink);
  }

  /* Mobile: stack annotations below wireframe */
  @media (max-width: 48rem) {
    .iawire__layout {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .iawire__phone-wrap {
      grid-column: 1;
      grid-row: 1;
      width: 240px;
      margin: 0 auto;
    }

    .iawire__note {
      grid-column: 1;
      padding: 0;
      justify-content: stretch;
    }

    .iawire__note--toggle { grid-row: 2; margin-top: 0; }
    .iawire__note--core   { grid-row: 3; margin-top: 0; }
    .iawire__note--advanced { grid-row: 4; margin-top: 0; }

    .iawire__note-inner,
    .iawire__note--right .iawire__note-inner {
      max-width: none;
      border-left: 2px solid var(--hairline);
      border-right: none;
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
    }

    .iawire__note-inner--accent {
      border-left-color: var(--accent);
    }
  }
</style>
