---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import heroBg from '../assets/hero-bg.png';
// hero-man.png intentionally kept in assets for possible later use.
import frameImg from '../assets/frame.png';
import Dakshxp from './Dakshxp.astro';
---

<section class="stage grid-bg">
  <div class="stage__pin">
    <!-- The painting: background scene + floating man. Scales down into the
         frame as the page scrolls; the frame border fades in around it. -->
    <div class="framed">
      <div class="scene">
        <Image
          class="scene__bg"
          src={heroBg}
          alt=""
          widths={[960, 1440, 1920, 2560, 3456]}
          sizes="100vw"
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <Image class="frame" src={frameImg} alt="" widths={[820, 1640]} sizes="70vw" loading="eager" />
    </div>

    <!-- Foreground copy + nav. Fades out as the scene collapses into the frame. -->
    <div class="overlay">
      <header class="nav">
        <a class="nav__logo" href="/" aria-label="Home">
          <Logo white />
        </a>
        <nav class="nav__links" aria-label="Primary">
          <a href="/about">About</a>
          <a href="#work">Work</a>
          <a href="#contact">Contact</a>
          <a class="nav__resume" href="/Daksh_Sharma_Resume.pdf" target="_blank" rel="noopener">Resume <span aria-hidden="true">&rsaquo;</span></a>
        </nav>
      </header>

      <div class="copy">
        <p class="copy__eyebrow">Hi! I am</p>
        <h1 class="copy__title">Daksh Sharma</h1>
        <p class="copy__tagline">Senior Product Designer</p>

        <Dakshxp />
      </div>
    </div>
  </div>
</section>

<style>
  .stage {
    /* Scroll runway: the extra height beyond one viewport is the distance
       over which the collapse-into-frame plays out. */
    height: 260vh;
  }

  .stage__pin {
    position: sticky;
    top: 0;
    display: grid;
    place-items: center;
    height: 100svh;
    overflow: hidden;
  }

  .framed {
    position: relative;
    width: min(64vw, 820px);
    aspect-ratio: 2152 / 1416;
    /* Default (pre-JS / first paint) ≈ full-bleed scene, frame off-screen.
       JS recomputes the exact cover scale and updates it on scroll. */
    transform: scale(2.4);
    transform-origin: center center;
    will-change: transform;
  }

  .scene {
    position: absolute;
    /* Inset to the frame's inner opening (measured from the PNG's alpha). */
    inset: 7.3% 5.6% 7.5% 5.6%;
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .scene__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .scene__man {
    position: relative;
    width: 34%;
    height: auto;
    animation: float 6s ease-in-out infinite alternate;
    will-change: transform;
  }

  .frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    will-change: opacity;
  }

  .overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    will-change: opacity;
  }

  .nav {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--space-lg) var(--space-xl);
    gap: var(--space-lg);
  }

  .nav__logo {
    display: inline-flex;
    align-items: center;
    color: #fff;
  }

  .nav__links {
    display: flex;
    gap: var(--space-lg);
    font-size: var(--font-md);
    font-weight: 500;
  }

  .nav__links a {
    position: relative;
    padding-bottom: 2px;
  }

  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .nav__links a:hover::after,
  .nav__links a:focus-visible::after {
    transform: scaleX(1);
  }

  .nav__resume {
    background: #fff;
    color: var(--accent) !important;
    border-radius: var(--radius-pill);
    padding: 0.4rem 1.2rem !important;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    line-height: 1;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .nav__resume::after {
    display: none !important;
  }

  .nav__resume:hover {
    background: rgba(255, 255, 255, 0.85);
    transform: scale(1.03);
  }

  .nav__resume span {
    margin-left: 0.15em;
    font-size: 1.1em;
  }

  .copy {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-xl);
    padding-bottom: 14vh;
    /* Non-interactive text; let clicks pass through to the nav beneath it. */
    pointer-events: none;
  }

  .copy__eyebrow {
    font-size: var(--font-lg);
    font-weight: 700;
    margin-bottom: var(--space-xs);
  }

  .copy__title {
    font-size: var(--font-display);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .copy__tagline {
    margin-top: var(--space-xs);
    font-size: var(--font-lg);
    font-weight: 500;
  }

  @keyframes float {
    from {
      transform: translateY(-0.6rem) rotate(-0.4deg);
    }
    to {
      transform: translateY(0.6rem) rotate(0.4deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene__man {
      animation: none;
    }
  }

  @media (max-width: 40rem) {
    .framed {
      width: 86vw;
    }

    .nav {
      padding: var(--space-md);
    }

    .nav__links {
      gap: var(--space-md);
      font-size: var(--font-sm);
    }

    .copy__tagline {
      font-size: var(--font-base);
    }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('.stage');
  const framed = document.querySelector<HTMLElement>('.framed');
  const frame = document.querySelector<HTMLElement>('.frame');
  const overlay = document.querySelector<HTMLElement>('.overlay');

  if (stage && framed && frame && overlay) {
    // Fraction of the frame taken up by its border, per axis (from the PNG).
    const INSET_X = 0.056 + 0.056;
    const INSET_Y = 0.073 + 0.075;

    const clamp = (t: number) => (t < 0 ? 0 : t > 1 ? 1 : t);
    const smooth = (t: number) => t * t * (3 - 2 * t);

    // The collapse completes at this fraction of the pinned scroll range; the
    // remainder holds the finished painting on the wall before it unpins.
    const ANIM_END = 0.72;

    let coverScale = 2.4;
    let runway = 1;

    function measure() {
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      // offsetWidth/Height are layout sizes, unaffected by the transform.
      const sceneW = framed!.offsetWidth * (1 - INSET_X);
      const sceneH = framed!.offsetHeight * (1 - INSET_Y);
      // Scale at which the inner scene just covers the viewport.
      coverScale = Math.max(vw / sceneW, vh / sceneH) * 1.04;
      runway = Math.max(1, stage!.offsetHeight - vh);
    }

    let ticking = false;
    function render() {
      ticking = false;
      const raw = clamp(-stage!.getBoundingClientRect().top / runway);
      const p = clamp(raw / ANIM_END);
      const eased = smooth(p);

      framed!.style.transform = `scale(${coverScale + (1 - coverScale) * eased})`;
      frame!.style.opacity = String(smooth(clamp((p - 0.55) / 0.4)));

      const copyOpacity = 1 - smooth(clamp(p / 0.4));
      overlay!.style.opacity = String(copyOpacity);
      overlay!.style.pointerEvents = copyOpacity < 0.05 ? 'none' : '';
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(render);
      }
    }

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    function init() {
      measure();
      render();
    }

    init();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      render();
    });
    // Re-measure once the frame image has loaded (aspect-ratio holds layout,
    // but this guards against late font/layout shifts).
    window.addEventListener('load', init);
  }
</script>
