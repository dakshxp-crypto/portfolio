---
// ReaderSpectrum — the horizontal depth spectrum of three CGM readers.
// Reusable at any size. Pass `highlight` to grey-out everything except the
// named band/zone; default (null) shows full color.
interface Props {
  highlight?: 'seeker' | 'changer' | 'diabetic' | 'overlap' | null;
}
const { highlight = null } = Astro.props;
const cls = highlight ? `spectrum spectrum--hl spectrum--hl-${highlight}` : 'spectrum';
---

<div class={cls} aria-label="Reader depth spectrum">
  <!-- Axis label -->
  <div class="spectrum__axis" aria-hidden="true">
    <span class="spectrum__anchor-l">glance · today</span>
    <span class="spectrum__arrow">how deep the reader goes →</span>
    <span class="spectrum__anchor-r">clinical · trends</span>
  </div>

  <!-- Three lanes, each with label + bar + pills -->
  <div class="spectrum__field">
    <!-- Shared overlap zone background spanning all lanes -->
    <div class="spectrum__overlap" aria-hidden="true">
      <span class="spectrum__overlap-label">shared core</span>
    </div>

    <!-- LANE 1: Seeker -->
    <div class="spectrum__lane spectrum__lane--seeker">
      <span class="spectrum__lane-label" data-reader="seeker">The Seeker</span>
      <div class="spectrum__bar spectrum__bar--seeker"></div>
    </div>

    <!-- LANE 2: Changer -->
    <div class="spectrum__lane spectrum__lane--changer">
      <span class="spectrum__lane-label" data-reader="changer">The Changer</span>
      <div class="spectrum__bar spectrum__bar--changer">
        <span class="spectrum__doctor" aria-hidden="true">→ doctor</span>
      </div>
    </div>

    <!-- LANE 3: Diabetic -->
    <div class="spectrum__lane spectrum__lane--diabetic">
      <span class="spectrum__lane-label" data-reader="diabetic">The Diabetic</span>
      <div class="spectrum__bar spectrum__bar--diabetic"></div>
    </div>

    <!-- Shared pills — spanning the overlap zone across all lanes -->
    <div class="spectrum__pills spectrum__pills--shared" aria-label="Shared metrics">
      <span class="spectrum__pill spectrum__pill--shared">Avg glucose</span>
      <span class="spectrum__pill spectrum__pill--shared">Time in range</span>
      <span class="spectrum__pill spectrum__pill--shared">Today's trend</span>
    </div>

    <!-- Changer deep pills — in changer's extended zone (right of overlap) -->
    <div class="spectrum__pills spectrum__pills--changer" aria-label="Changer-depth metrics">
      <span class="spectrum__pill spectrum__pill--deep">Weekly trends</span>
      <span class="spectrum__pill spectrum__pill--deep">Share</span>
    </div>

    <!-- Diabetic deep pills — far right of diabetic lane -->
    <div class="spectrum__pills spectrum__pills--diabetic" aria-label="Clinical-depth metrics">
      <span class="spectrum__pill spectrum__pill--deep">AGP</span>
      <span class="spectrum__pill spectrum__pill--deep">SD</span>
      <span class="spectrum__pill spectrum__pill--deep">Variability</span>
      <span class="spectrum__pill spectrum__pill--deep">TIR trends</span>
    </div>
  </div>

  <!-- Seeker downward cluster — outside the field, below it, aligned under seeker -->
  <div class="spectrum__seeker-depth" aria-label="Seeker depth: understanding">
    <svg class="spectrum__down-arrow" viewBox="0 0 2 20" width="2" height="20" aria-hidden="true">
      <line x1="1" y1="0" x2="1" y2="20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
    <div class="spectrum__depth-pills">
      <span class="spectrum__pill spectrum__pill--understanding">Education</span>
      <span class="spectrum__pill spectrum__pill--understanding">Plain language</span>
      <span class="spectrum__pill spectrum__pill--understanding">Encouragement</span>
    </div>
  </div>
</div>

<style>
  /* -- Label column width -- */
  .spectrum {
    --label-w: 6.5rem;
    --lane-h: 3rem;
    --lane-gap: 0.75rem;
    --bar-radius: 8px;
    --pill-radius: 999px;
    position: relative;
    width: 100%;
  }

  /* ---- Axis ---- */
  .spectrum__axis {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-md);
    padding-left: var(--label-w);
    font-size: var(--font-xs);
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  .spectrum__arrow {
    font-weight: 600;
    color: var(--ink);
    letter-spacing: 0.04em;
  }
  .spectrum__anchor-l,
  .spectrum__anchor-r {
    font-weight: 500;
    white-space: nowrap;
  }

  /* ---- Field (the stacked lanes area) ---- */
  .spectrum__field {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--lane-gap);
  }

  /* Overlap zone background spanning all lanes */
  .spectrum__overlap {
    position: absolute;
    top: -0.5rem;
    bottom: -0.5rem;
    left: var(--label-w);
    width: calc((100% - var(--label-w)) * 0.333);
    background: rgba(231, 95, 56, 0.04);
    border-radius: var(--bar-radius);
    border-right: 1.5px dashed rgba(231, 95, 56, 0.22);
    pointer-events: none;
    z-index: 0;
  }
  .spectrum__overlap-label {
    position: absolute;
    top: -0.3rem;
    left: 50%;
    transform: translate(-50%, -100%);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(231, 95, 56, 0.5);
    white-space: nowrap;
  }

  /* ---- Lanes ---- */
  .spectrum__lane {
    display: flex;
    align-items: center;
    height: var(--lane-h);
    position: relative;
    z-index: 1;
  }

  .spectrum__lane-label {
    width: var(--label-w);
    flex-shrink: 0;
    font-size: var(--font-xs);
    font-weight: 700;
    color: var(--ink);
    white-space: nowrap;
    padding-right: var(--space-sm);
  }

  /* ---- Bars (the colored horizontal bands) ---- */
  .spectrum__bar {
    position: relative;
    height: 100%;
    border-radius: var(--bar-radius);
    transition: opacity 0.3s ease, filter 0.3s ease;
  }
  .spectrum__bar--seeker {
    width: calc((100% - var(--label-w)) * 0.333);
    background: rgba(231, 95, 56, 0.10);
    border: 1.5px solid rgba(231, 95, 56, 0.22);
  }
  .spectrum__bar--changer {
    width: calc((100% - var(--label-w)) * 0.666);
    background: rgba(231, 95, 56, 0.15);
    border: 1.5px solid rgba(231, 95, 56, 0.28);
  }
  .spectrum__bar--diabetic {
    width: calc(100% - var(--label-w));
    background: rgba(231, 95, 56, 0.22);
    border: 1.5px solid rgba(231, 95, 56, 0.35);
  }

  .spectrum__doctor {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translate(calc(100% + 0.5rem), -50%);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  /* ---- Pills ---- */
  .spectrum__pills {
    position: absolute;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .spectrum__pill {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: var(--pill-radius);
    white-space: nowrap;
    line-height: 1.4;
  }
  .spectrum__pill--shared {
    background: #fff;
    border: 1.5px solid rgba(0, 0, 0, 0.18);
    color: var(--ink);
  }
  .spectrum__pill--deep {
    background: var(--accent);
    color: #fff;
    border: 1.5px solid var(--accent);
  }
  .spectrum__pill--understanding {
    background: #2a7b5b;
    color: #fff;
    border: 1.5px solid #2a7b5b;
  }

  /* Shared pills — horizontal row inside the overlap zone, vertically centered across all 3 lanes */
  .spectrum__pills--shared {
    top: calc(var(--lane-h) * 1.5 + var(--lane-gap));
    left: calc(var(--label-w) + 0.5rem);
    transform: translateY(-50%);
    flex-direction: row;
    align-items: center;
    gap: 0.3rem;
  }

  /* Changer deep pills — horizontally centered in the 33%–66% band of the bar area,
     vertically centered in the changer lane */
  .spectrum__pills--changer {
    top: calc(var(--lane-h) + var(--lane-gap) + var(--lane-h) / 2);
    left: calc(var(--label-w) + (100% - var(--label-w)) * 0.5);
    transform: translate(-50%, -50%);
    justify-content: center;
  }

  /* Diabetic deep pills — horizontally centered in the 66%–100% band,
     vertically centered in the diabetic lane */
  .spectrum__pills--diabetic {
    top: calc((var(--lane-h) + var(--lane-gap)) * 2 + var(--lane-h) / 2);
    left: calc(var(--label-w) + (100% - var(--label-w)) * 0.833);
    transform: translate(-50%, -50%);
    justify-content: center;
    gap: 0.3rem;
  }

  /* ---- Seeker downward cluster (outside the field) ---- */
  .spectrum__seeker-depth {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 0.35rem;
    margin-left: calc(var(--label-w) + (100% - var(--label-w)) * 0.166);
    width: fit-content;
    transform: translateX(-50%);
  }
  .spectrum__down-arrow {
    color: #2a7b5b;
    flex: none;
  }
  .spectrum__depth-pills {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.25rem;
  }

  /* ---- Highlight mode ---- */
  .spectrum--hl .spectrum__bar,
  .spectrum--hl .spectrum__pills,
  .spectrum--hl .spectrum__overlap,
  .spectrum--hl .spectrum__seeker-depth,
  .spectrum--hl .spectrum__lane-label {
    opacity: 0.15;
    filter: saturate(0);
  }

  .spectrum--hl-seeker .spectrum__bar--seeker,
  .spectrum--hl-seeker .spectrum__lane--seeker .spectrum__lane-label,
  .spectrum--hl-seeker .spectrum__pills--shared,
  .spectrum--hl-seeker .spectrum__seeker-depth {
    opacity: 1;
    filter: none;
  }

  .spectrum--hl-changer .spectrum__bar--changer,
  .spectrum--hl-changer .spectrum__lane--changer .spectrum__lane-label,
  .spectrum--hl-changer .spectrum__pills--shared,
  .spectrum--hl-changer .spectrum__pills--changer {
    opacity: 1;
    filter: none;
  }

  .spectrum--hl-diabetic .spectrum__bar--diabetic,
  .spectrum--hl-diabetic .spectrum__lane--diabetic .spectrum__lane-label,
  .spectrum--hl-diabetic .spectrum__pills--shared,
  .spectrum--hl-diabetic .spectrum__pills--diabetic {
    opacity: 1;
    filter: none;
  }

  .spectrum--hl-overlap .spectrum__overlap,
  .spectrum--hl-overlap .spectrum__pills--shared {
    opacity: 1;
    filter: none;
  }
  .spectrum--hl-overlap .spectrum__bar {
    opacity: 0.35;
    filter: saturate(0.3);
  }

  /* ---- Responsive ---- */
  @media (max-width: 40rem) {
    .spectrum {
      --label-w: 5rem;
      --lane-h: 2.25rem;
    }
    .spectrum__pill {
      font-size: 0.55rem;
      padding: 0.12rem 0.4rem;
    }
    .spectrum__axis {
      font-size: 0.6rem;
    }
    .spectrum__doctor {
      font-size: 0.55rem;
    }
    .spectrum__overlap-label {
      font-size: 0.5rem;
    }
  }
</style>
