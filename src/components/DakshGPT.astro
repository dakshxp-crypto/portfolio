---
// DakshGPT — an AI concierge for the portfolio.
// Skeleton only: responses are stubbed client-side until the knowledge base
// (daksh.md) is wired to a real endpoint at /api/chat.
const suggestions = [
  'How does Daksh use AI in his process?',
  'What are Daksh’s strengths?',
  'Is Daksh a fit for research-heavy work?',
];
---

<aside class="dgpt" data-state="open" aria-label="DakshGPT assistant">
  {/* Minimized launcher */}
  <button class="dgpt__launcher" type="button" data-action="open">
    <span class="dgpt__mark" aria-hidden="true">D</span>
    <span class="dgpt__launcher-text">DakshGPT</span>
  </button>

  {/* Open panel */}
  <section class="dgpt__panel" role="dialog" aria-label="Chat with DakshGPT">
    <header class="dgpt__head">
      <div class="dgpt__brand">
        <span class="dgpt__mark" aria-hidden="true">D</span>
        <div class="dgpt__brand-text">
          <p class="dgpt__name">DakshGPT</p>
          <p class="dgpt__desc">The world’s first AI-first portfolio. Ask me anything about Daksh.</p>
        </div>
      </div>
      <button class="dgpt__min" type="button" data-action="minimize" aria-label="Minimize chat">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 8h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
    </header>

    <div class="dgpt__body">
      <div class="dgpt__messages" role="log" aria-live="polite">
        <div class="dgpt__msg dgpt__msg--bot">
          Hi, I’m DakshGPT. Ask me about Daksh’s process, his AI work, or whether
          he’s the right senior product designer for your team.
        </div>
      </div>

      <div class="dgpt__chips">
        {suggestions.map((s) => (
          <button class="dgpt__chip" type="button" data-suggest={s}>{s}</button>
        ))}
      </div>
    </div>

    <form class="dgpt__form" autocomplete="off">
      <input
        class="dgpt__input"
        type="text"
        name="message"
        placeholder="How does Daksh use AI in his process?"
        aria-label="Message DakshGPT"
      />
      <button class="dgpt__send" type="submit" aria-label="Send message">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M4 10h11M10 5l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
      </button>
    </form>
  </section>
</aside>

<style>
  .dgpt {
    position: fixed;
    right: var(--space-lg);
    bottom: var(--space-lg);
    z-index: 1000;
    color: var(--ink);
    font-size: var(--font-base);
  }

  /* ---- Launcher (minimized) ---- */
  .dgpt__launcher {
    display: none;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-lg) var(--space-sm) var(--space-sm);
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);
    cursor: pointer;
    font-weight: 600;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .dgpt__launcher:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.22);
  }

  .dgpt[data-state='minimized'] .dgpt__launcher {
    display: inline-flex;
  }

  .dgpt[data-state='minimized'] .dgpt__panel {
    display: none;
  }

  /* ---- Brand mark (logo slot) ---- */
  .dgpt__mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: var(--font-md);
  }

  /* ---- Panel (open) ---- */
  .dgpt__panel {
    display: flex;
    flex-direction: column;
    width: min(23.5rem, calc(100vw - 2rem));
    height: 27rem;
    max-height: calc(100vh - 2 * var(--space-lg));
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.24);
    overflow: hidden;
    transition: height 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Grows once a conversation starts. */
  .dgpt.is-conversing .dgpt__panel {
    height: min(40rem, calc(100vh - 2 * var(--space-lg)));
  }

  .dgpt__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-md);
    border-bottom: 1px solid var(--hairline);
  }

  .dgpt__brand {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .dgpt__name {
    font-weight: 700;
    line-height: 1.1;
  }

  .dgpt__desc {
    font-size: var(--font-xs);
    color: var(--muted);
    line-height: 1.35;
    max-width: 15rem;
  }

  .dgpt__min {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
    border: none;
    background: transparent;
    color: var(--muted);
    border-radius: 50%;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .dgpt__min:hover {
    background: rgba(0, 0, 0, 0.05);
    color: var(--ink);
  }

  /* ---- Body / messages ---- */
  .dgpt__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding: var(--space-md);
    gap: var(--space-md);
  }

  .dgpt__messages {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  /* ---- Suggestion chips ---- */
  .dgpt__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: auto;
  }

  .dgpt.is-conversing .dgpt__chips {
    display: none;
  }

  .dgpt__chip {
    font-size: var(--font-xs);
    padding: var(--space-2xs) var(--space-sm);
    background: transparent;
    color: var(--muted);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    cursor: pointer;
    text-align: left;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .dgpt__chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ---- Input ---- */
  .dgpt__form {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md) var(--space-md);
    border-top: 1px solid var(--hairline);
  }

  .dgpt__input {
    flex: 1;
    min-width: 0;
    padding: var(--space-sm) var(--space-md);
    font: inherit;
    font-size: var(--font-sm);
    color: var(--ink);
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .dgpt__input:focus {
    border-color: var(--accent);
    background: var(--surface);
  }

  .dgpt__input::placeholder {
    color: var(--muted);
    transition: opacity 0.25s ease;
  }

  .dgpt__input.is-fading::placeholder {
    opacity: 0;
  }

  .dgpt__send {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border: none;
    background: var(--accent);
    color: #fff;
    border-radius: 50%;
    cursor: pointer;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .dgpt__send:hover {
    transform: scale(1.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .dgpt__panel { transition: none; }
  }

  @media (max-width: 30rem) {
    .dgpt {
      right: var(--space-sm);
      bottom: var(--space-sm);
      left: var(--space-sm);
    }
    .dgpt__panel {
      width: 100%;
      height: 24rem;
    }
  }
</style>

<style is:global>
  /* Applied to message and typing nodes created in JS, which do not carry
     Astro's scoped data attribute. All classes are dgpt__-namespaced. */
  .dgpt__msg {
    max-width: 85%;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    line-height: 1.45;
    font-size: var(--font-sm);
    animation: dgpt-in 0.28s ease both;
  }

  .dgpt__msg--bot {
    align-self: flex-start;
    background: rgba(0, 0, 0, 0.05);
    color: var(--ink);
    border-bottom-left-radius: 4px;
  }

  .dgpt__msg--user {
    align-self: flex-end;
    background: var(--accent);
    color: #fff;
    border-bottom-right-radius: 4px;
  }

  .dgpt__typing {
    display: inline-flex;
    gap: 4px;
    align-self: flex-start;
    padding: var(--space-md);
  }

  .dgpt__typing span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--muted);
    animation: dgpt-bounce 1.2s infinite ease-in-out;
  }

  .dgpt__typing span:nth-child(2) { animation-delay: 0.15s; }
  .dgpt__typing span:nth-child(3) { animation-delay: 0.3s; }

  @keyframes dgpt-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes dgpt-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
    30% { transform: translateY(-5px); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dgpt__msg { animation: none; }
    .dgpt__typing span { animation: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.dgpt');
  if (root) {
    const panel = root.querySelector<HTMLElement>('.dgpt__panel')!;
    const form = root.querySelector<HTMLFormElement>('.dgpt__form')!;
    const input = root.querySelector<HTMLInputElement>('.dgpt__input')!;
    const messages = root.querySelector<HTMLElement>('.dgpt__messages')!;

    const QUESTIONS = [
      'How does Daksh use AI in his process?',
      'Has Daksh shipped AI products?',
      'What are Daksh’s strengths?',
      'Is Daksh a fit for research-heavy work?',
      'Tell me about Daksh’s past experience.',
      'Is Daksh a good team player?',
      'How does Daksh approach 0 to 1 problems?',
      'Can Daksh own strategy through to ship?',
    ];

    // --- Rotating placeholder ---
    let qi = 0;
    let rotating = true;
    setInterval(() => {
      if (!rotating || document.activeElement === input || input.value) return;
      input.classList.add('is-fading');
      setTimeout(() => {
        input.setAttribute('placeholder', QUESTIONS[qi]);
        qi = (qi + 1) % QUESTIONS.length;
        input.classList.remove('is-fading');
      }, 250);
    }, 3200);

    input.addEventListener('focus', () => (rotating = false));
    input.addEventListener('blur', () => { if (!input.value) rotating = true; });

    // --- Open / minimize ---
    root.addEventListener('click', (e) => {
      const action = (e.target as HTMLElement).closest('[data-action]')?.getAttribute('data-action');
      if (action === 'minimize') root.dataset.state = 'minimized';
      if (action === 'open') { root.dataset.state = 'open'; input.focus(); }
    });

    // --- Messages ---
    function addMessage(text: string, who: 'user' | 'bot') {
      const el = document.createElement('div');
      el.className = `dgpt__msg dgpt__msg--${who}`;
      el.textContent = text;
      messages.appendChild(el);
      panel.querySelector('.dgpt__body')!.scrollTo({ top: 99999, behavior: 'smooth' });
      return el;
    }

    function addTyping() {
      const el = document.createElement('div');
      el.className = 'dgpt__typing';
      el.innerHTML = '<span></span><span></span><span></span>';
      messages.appendChild(el);
      panel.querySelector('.dgpt__body')!.scrollTo({ top: 99999, behavior: 'smooth' });
      return el;
    }

    // Stubbed response. Replace with a fetch('/api/chat') call once daksh.md
    // is connected.
    function stubReply(question: string) {
      return `Once Daksh connects his knowledge base, I’ll answer “${question}” in his own words, grounded in his case studies and experience. This is a preview of how DakshGPT will respond.`;
    }

    function send(text: string) {
      const trimmed = text.trim();
      if (!trimmed) return;
      root.classList.add('is-conversing');
      addMessage(trimmed, 'user');
      input.value = '';
      rotating = true;
      const typing = addTyping();
      window.setTimeout(() => {
        typing.remove();
        addMessage(stubReply(trimmed), 'bot');
      }, 1500);
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      send(input.value);
    });

    root.querySelectorAll<HTMLButtonElement>('.dgpt__chip').forEach((chip) => {
      chip.addEventListener('click', () => send(chip.dataset.suggest || ''));
    });

    // Start minimized on small screens so it doesn't cover content.
    if (window.matchMedia('(max-width: 30rem)').matches) {
      root.dataset.state = 'minimized';
    }
  }
</script>
