---
import Logo from './Logo.astro';
---

<nav class="stickynav" data-shown="false" aria-label="Site">
  <a class="stickynav__brand" href="/" aria-label="Home">
    <Logo />
  </a>
  <div class="stickynav__links">
    <a href="/about">About</a>
    <a href="/#work">Work</a>
    <a href="/#contact">Contact</a>
    <a class="stickynav__resume" href="/Daksh_Sharma_Resume.pdf" target="_blank" rel="noopener">Resume <span aria-hidden="true">&rsaquo;</span></a>
  </div>
</nav>

<style>
  .stickynav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 900;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding: var(--space-md) var(--space-xl);
    background: var(--surface);
    color: var(--ink);
    border-bottom: 1px solid var(--hairline);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    /* Hidden above the top until scrolled past the hero. */
    transform: translateY(-100%);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .stickynav[data-shown='true'] {
    transform: translateY(0);
  }

  .stickynav__brand {
    display: inline-flex;
    align-items: center;
  }

  .stickynav__links {
    display: flex;
    gap: var(--space-lg);
    font-size: var(--font-md);
    font-weight: 500;
  }
  .stickynav__links a {
    position: relative;
    color: var(--ink);
    padding-bottom: 2px;
  }
  .stickynav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .stickynav__links a:hover::after,
  .stickynav__links a:focus-visible::after {
    transform: scaleX(1);
  }

  .stickynav__resume {
    background: var(--accent);
    color: #fff !important;
    border-radius: var(--radius-pill);
    padding: 0.4rem 1.2rem !important;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    line-height: 1;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .stickynav__resume::after {
    display: none !important;
  }

  .stickynav__resume:hover {
    background: #d14e2b;
    transform: scale(1.03);
  }

  .stickynav__resume span {
    margin-left: 0.15em;
    font-size: 1.1em;
  }

  @media (max-width: 40rem) {
    .stickynav {
      padding: var(--space-sm) var(--space-md);
    }
    .stickynav__links {
      gap: var(--space-md);
      font-size: var(--font-sm);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stickynav {
      transition: none;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('.stickynav');
  if (nav) {
    let ticking = false;
    function render() {
      ticking = false;
      // Reveal once the hero has shrunk and its own nav has faded out.
      const threshold = window.innerHeight * 0.55;
      nav!.dataset.shown = window.scrollY > threshold ? 'true' : 'false';
    }
    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(render);
      }
    }
    render();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', render);
  }
</script>
