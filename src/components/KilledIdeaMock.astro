---
// Inline SVG mock of the killed camera install-assistant prototype.
// Shows the core contradiction: a confident "sensor seated correctly" overlay
// on a sensor that is visibly NOT seated correctly.
---

<div class="ki-mock">
  <svg class="ki-mock__svg" viewBox="0 0 260 462" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Killed prototype: a camera install-assistant confidently says the sensor is seated correctly, but the sensor is visibly lifting off the arm, the contradiction that killed the idea.">
    <!-- Phone frame -->
    <rect x="2" y="2" width="256" height="458" rx="28" fill="#1a1a1a" stroke="#333" stroke-width="1.5"/>
    <rect x="10" y="10" width="240" height="442" rx="22" fill="#2a2a2a"/>

    <!-- Camera viewfinder area -->
    <rect x="14" y="50" width="232" height="350" rx="4" fill="#e8ddd4"/>

    <!-- Viewfinder corners -->
    <path d="M30 70 L30 56 L44 56" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M230 70 L230 56 L216 56" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M30 380 L30 394 L44 394" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M230 380 L230 394 L216 394" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" stroke-linecap="round"/>

    <!-- Status bar -->
    <text x="130" y="34" text-anchor="middle" font-size="9" fill="#888" font-family="system-ui,sans-serif">Install Assistant</text>
    <circle cx="230" cy="30" r="4" fill="none" stroke="#888" stroke-width="1"/>
    <text x="230" y="33" text-anchor="middle" font-size="6" fill="#888" font-family="system-ui,sans-serif">×</text>

    <!-- ═══ ARM (simple skin-toned shape) ═══ -->
    <ellipse cx="130" cy="260" rx="110" ry="80" fill="#d4b89c"/>
    <ellipse cx="130" cy="260" rx="95" ry="68" fill="#dcc4a8"/>

    <!-- ═══ CGM SENSOR — visibly wrong, lifting at one edge ═══ -->
    <!-- Shadow showing gap on right side -->
    <ellipse cx="138" cy="222" rx="28" ry="6" fill="rgba(0,0,0,0.12)"/>

    <!-- Sensor base (tilted — left side on skin, right side lifted) -->
    <g transform="translate(130,210) rotate(-8)">
      <!-- Adhesive patch -->
      <rect x="-30" y="-18" width="60" height="36" rx="6" fill="#f0f0f0" stroke="#ccc" stroke-width="0.8"/>
      <!-- Sensor housing -->
      <rect x="-14" y="-12" width="28" height="24" rx="4" fill="#e0e0e0" stroke="#bbb" stroke-width="0.8"/>
      <circle cx="0" cy="0" r="3" fill="#ccc"/>
      <!-- Tiny filament hint -->
      <line x1="0" y1="12" x2="0" y2="18" stroke="#aaa" stroke-width="0.6"/>
    </g>

    <!-- Visible gap between sensor right edge and skin -->
    <path d="M152 196 Q156 204 154 212" fill="none" stroke="var(--accent)" stroke-width="1.2" stroke-dasharray="2 2"/>

    <!-- Gap callout arrow -->
    <line x1="156" y1="204" x2="178" y2="194" stroke="var(--accent)" stroke-width="1"/>
    <circle cx="178" cy="194" r="1.5" fill="var(--accent)"/>
    <text x="182" y="192" font-size="7" font-weight="600" fill="var(--accent)" font-family="system-ui,sans-serif">gap</text>
    <text x="182" y="200" font-size="6" fill="var(--accent)" font-family="system-ui,sans-serif">lifting off skin</text>

    <!-- ═══ AR OVERLAY — the confident wrong answer ═══ -->
    <!-- Success banner (green, confident) -->
    <rect x="38" y="268" width="184" height="52" rx="10" fill="rgba(34,160,80,0.92)"/>
    <rect x="38" y="268" width="184" height="52" rx="10" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="0.8"/>

    <!-- Checkmark circle -->
    <circle cx="68" cy="294" r="14" fill="rgba(255,255,255,0.2)"/>
    <path d="M60 294 L66 300 L78 286" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>

    <!-- Confident text -->
    <text x="90" y="290" font-size="10" font-weight="700" fill="#fff" font-family="system-ui,sans-serif">Sensor seated correctly</text>
    <text x="90" y="304" font-size="8" fill="rgba(255,255,255,0.8)" font-family="system-ui,sans-serif">You're good to go!</text>

    <!-- Scanning animation dots -->
    <circle cx="60" cy="340" r="2" fill="rgba(34,160,80,0.4)"/>
    <circle cx="72" cy="336" r="1.5" fill="rgba(34,160,80,0.3)"/>
    <circle cx="82" cy="342" r="2" fill="rgba(34,160,80,0.25)"/>

    <!-- Bottom bar -->
    <rect x="14" y="408" width="232" height="40" rx="0" fill="#1e1e1e"/>
    <rect x="108" y="418" width="44" height="22" rx="11" fill="rgba(255,255,255,0.12)"/>
    <circle cx="130" cy="429" r="7" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.2"/>

    <!-- Home indicator -->
    <rect x="100" y="448" width="60" height="4" rx="2" fill="#555"/>
  </svg>
</div>

<style>
  .ki-mock {
    width: 100%;
    max-width: 14rem;
    aspect-ratio: 9 / 16;
  }

  .ki-mock__svg {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
