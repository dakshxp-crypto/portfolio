---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import WorkSection from '../components/WorkSection.astro';
---

<BaseLayout
  title="Daksh Sharma | Senior Product Designer"
  description="Senior Product Designer working where AI, health, and high-craft interfaces meet, building the whole thing from strategy to ship."
>
  <main>
    <Hero />
    <section class="grid-bg page-content">
      <WorkSection />
    </section>
  </main>
</BaseLayout>

<style>
  .page-content {
    min-height: 100vh;
  }
</style>
