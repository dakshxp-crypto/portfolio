    color: var(--muted);
    background: rgba(0, 0, 0, 0.06);
    clip-path: polygon(0 0, calc(100% - 1rem) 0, 100% 50%, calc(100% - 1rem) 100%, 0 100%, 1rem 50%);
  }
  .viz02__chevron:first-child { margin-left: 0; }
  .viz02__chevron--active {
    position: relative;
    z-index: 1;
    height: 4rem;
    margin-top: -0.375rem;
    margin-bottom: -0.375rem;
    color: #fff;
    background: var(--accent);
    font-size: var(--font-md);
  }
  @media (max-width: 40rem) {
    .viz02__callout p { font-size: var(--font-xs); }
    .viz02__chevron { font-size: var(--font-xs); padding: 0 var(--space-sm); }
    .viz02__chevron--active { font-size: var(--font-sm); }
  }

  .stagetable {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 1rem;
    line-height: 1.5;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .stagetable th, .stagetable td {
    text-align: left;
    padding: var(--space-md);
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }
  .stagetable th { font-weight: 700; background: rgba(0, 0, 0, 0.03); }
  .stagetable tr:last-child td { border-bottom: none; }
  .stagetable__name { font-weight: 700; white-space: nowrap; }

  /* ---- VIZ-03: impact vs effort, a real two-axis quadrant ---- */
  .viz03 { max-width: 36rem; padding: var(--space-lg); border: 1px solid var(--hairline); border-radius: var(--radius-md); }
  .viz03__chart { display: flex; gap: var(--space-sm); }
  .viz03__ylabel {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: var(--font-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .viz03__plotwrap { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--space-xs); }
  .viz03__plot {
    position: relative;
    aspect-ratio: 5 / 4;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  /* Exactly one line on each axis, crossing at the centre: a quadrant, not a grid. */
  .viz03__plot::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--hairline);
  }
  .viz03__plot::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--hairline);
  }
  .viz03__pt {
    position: absolute;
    transform: translate(-50%, -50%);
    font-size: var(--font-sm);
    font-weight: 700;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    background: var(--surface);
    border: 1px solid var(--hairline);
    color: var(--muted);
    z-index: 1;
  }
  .viz03__pt--action {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 6.5rem;
    height: 6.5rem;
    padding: 0.5rem;
    border-radius: 50%;
    white-space: normal;
    line-height: 1.15;
    font-size: var(--font-md);
    font-weight: 700;
    background: rgba(231, 95, 56, 0.16);
    border: 2px solid var(--accent);
    color: var(--accent);
    box-shadow: 0 8px 20px rgba(231, 95, 56, 0.16);
    z-index: 2;
  }
  @media (max-width: 34rem) {
    .viz03__pt--action { width: 5rem; height: 5rem; font-size: var(--font-sm); }
  }
  .viz03__xrow {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-size: var(--font-xs);
    color: var(--muted);
  }
  .viz03__xlabel { font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
  .viz03__tick { opacity: 0.7; }

  /* ---- The fork: two methods converging on the one I chose ---- */
  .forkviz { margin-top: var(--space-lg); }
  .forkviz__svg { display: block; width: 100%; max-width: 46rem; height: auto; }
  .forkviz__svg text {
    font-family: 'Satoshi', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }
  .forkviz__path { fill: none; stroke-width: 3; }
  .forkviz__path--rejected { stroke: var(--hairline); stroke-dasharray: 5 5; }
  .forkviz__path--chosen { stroke: var(--accent); }
  .forkviz__rect { fill: var(--surface); stroke: var(--hairline); stroke-width: 1.5; }
  .forkviz__rect--chosen { fill: rgba(231, 95, 56, 0.04); stroke: var(--accent); stroke-width: 2; }
  .forkviz__tag {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    fill: var(--muted);
  }
  .forkviz__tag--chosen { fill: var(--accent); }
  .forkviz__desc { font-size: 14px; font-weight: 600; fill: var(--ink); }
  .forkviz__pillrect { fill: var(--accent); }
  .forkviz__pilltext { font-size: 15px; font-weight: 700; fill: #fff; }

  .pill-inline {
    display: inline-block;
    font-weight: 700;
    color: #fff;
    background: var(--accent);
    padding: 0.1em 0.6em;
    border-radius: var(--radius-pill);
    font-size: 0.9em;
  }

  /* ---- Reused decision-card grids (fixes / findings / reasons) ---- */
  .decisions4 {
    list-style: none;
    margin-top: var(--space-xl);
    display: grid;
    gap: var(--space-lg);
  }
  .reasons4 { grid-template-columns: repeat(2, 1fr); }
  .reasons3 { grid-template-columns: repeat(3, 1fr); }
  .fix {
    padding: var(--space-lg);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .fix--pulled { border: 2px solid var(--accent); background: rgba(231, 95, 56, 0.04); }
  .fix__lead { font-size: 1.125rem; font-weight: 700; line-height: 1.25; }
  .fix p { font-size: 1.125rem; line-height: 1.55; color: var(--muted); }
  @media (max-width: 48rem) {
    .reasons4, .reasons3 { grid-template-columns: 1fr; }
  }

  /* ---- Field notes: "Understanding the people" as a mock document ---- */
  .fielddoc {
    position: relative;
    margin-top: var(--space-xl);
    padding: var(--space-2xl);
    background: linear-gradient(180deg, #FFF9F2 0%, #FFF2E4 100%);
    border: 1px solid rgba(231, 95, 56, 0.18);
    border-radius: var(--radius-md);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.06), 0 2px 8px rgba(0, 0, 0, 0.04);
  }
  .fielddoc__tape {
    position: absolute;
    top: -0.7rem;
    left: 2.5rem;
    width: 4rem;
    height: 1.4rem;
    background: rgba(231, 95, 56, 0.22);
    border: 1px solid rgba(231, 95, 56, 0.3);
    transform: rotate(-3deg);
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
  }
  .fielddoc__header {
    margin-bottom: var(--space-lg);
  }
  .fielddoc__label {
    display: inline-block;
    font-size: var(--font-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius-pill);
  }
  .fielddoc__intro {
    font-size: 1.125rem;
    line-height: 1.6;
    max-width: 46rem;
  }
  .fielddoc__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: var(--space-md) 0 var(--space-lg);
  }
  .pill-chip {
    display: inline-block;
    font-size: var(--font-sm);
    font-weight: 600;
    padding: 0.3rem 0.85rem;
    background: var(--surface);
    border: 1px solid rgba(231, 95, 56, 0.25);
    border-radius: var(--radius-pill);
    color: var(--ink);
  }
  .fielddoc__aim {
    margin-bottom: var(--space-xl);
    padding: var(--space-lg);
    background: rgba(231, 95, 56, 0.08);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  .fielddoc__aimtag {
    display: block;
    font-size: var(--font-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-xs);
  }
  .fielddoc__aim p {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--ink);
  }
  .fielddoc__block {
    margin-top: var(--space-xl);
  }
  .fielddoc__block p { font-size: 1.125rem; }

  /* ---- Findings, highlighted more than the page's default card ---- */
  .findingshl {
    list-style: none;
    margin-top: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .findinghl {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--surface);
    border: 1px solid rgba(231, 95, 56, 0.22);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-md);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
  }
  .findinghl__num {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: var(--font-sm);
  }
  .findinghl__body h4 {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: var(--space-2xs);
  }
  .findinghl__body p {
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* ---- Study conditions (side by side) ---- */
  .study-conditions {
    margin-top: var(--space-lg);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }
  .study-cond {
    padding: var(--space-lg);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .study-cond__label {
    display: block;
    font-size: var(--font-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-sm);
  }
  .study-cond__quote {
    font-size: 1.125rem;
    font-style: italic;
    line-height: 1.4;
    margin-bottom: var(--space-sm);
  }
  .study-cond__note { font-size: var(--font-sm); color: var(--muted); }
  @media (max-width: 40rem) {
    .study-conditions { grid-template-columns: 1fr; }
  }

  /* ---- VIZ-04: timing ranges ---- */
  .viz04 { margin-top: var(--space-xl); padding: var(--space-lg); border: 1px solid var(--hairline); border-radius: var(--radius-md); background: var(--surface); }
  .viz04__row { display: flex; align-items: center; gap: var(--space-md); }
  .viz04__row + .viz04__row { margin-top: var(--space-md); }
  .viz04__label { flex-shrink: 0; width: 6rem; font-size: var(--font-sm); font-weight: 700; }
  .viz04__track { flex: 1; position: relative; height: 1.5rem; background: rgba(0, 0, 0, 0.04); border-radius: var(--radius-pill); }
  .viz04__bar {
    position: absolute;
    top: 0; bottom: 0;
    background: rgba(0, 0, 0, 0.18);
    border-radius: var(--radius-pill);
  }
  .viz04__bar--accent { background: var(--accent); }
  .viz04__end {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translate(-50%, -50%);
    font-size: var(--font-xs);
    font-weight: 700;
    background: var(--ink);
    color: #fff;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .viz04__end--right { left: 100%; }
  .viz04__labels {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-md);
    padding-left: 6.75rem;
    font-size: var(--font-sm);
    font-style: italic;
    color: var(--muted);
  }
  @media (max-width: 40rem) {
    .viz04__label { width: 4rem; font-size: var(--font-xs); }
    .viz04__labels { padding-left: 0; flex-direction: column; gap: var(--space-2xs); }
  }

  /* ---- VIZ-05: must ask vs can assume ---- */
  .viz05 { padding: var(--space-lg); border: 1px solid var(--hairline); border-radius: var(--radius-md); }
  .viz05__cols {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: var(--space-lg);
  }
  .viz05__colhead {
    font-size: var(--font-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: var(--space-sm);
  }
  .viz05__col--ask .viz05__colhead { color: var(--accent); }
  .viz05__col--assume .viz05__colhead { color: var(--muted); }
  .viz05__list {
    padding-left: 1.1em;
    font-size: 1.125rem;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }
  .viz05__chain {
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px dashed var(--hairline);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
  }
  .viz05__link {
    font-size: var(--font-sm);
    font-weight: 700;
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    background: var(--surface);
  }
  .viz05__arrow { color: var(--accent); font-weight: 700; }
  @media (max-width: 40rem) {
    .viz05__cols { grid-template-columns: 1fr; }
  }

  /* ---- Identity sequence (reused from the live page) ---- */
  /* ---- Kaira identity section: a subtle indigo-to-teal wash ---- */
  .identity {
    --kaira-indigo: #4B4FE0;
    --kaira-teal: #5FE0DE;
    margin-top: var(--space-xl);
    padding: var(--space-2xl) var(--space-xl);
    border: 1px solid rgba(75, 79, 224, 0.1);
    border-radius: var(--radius-md);
    background:
      radial-gradient(ellipse 60% 50% at 0% 0%, rgba(75, 79, 224, 0.07), transparent 60%),
      radial-gradient(ellipse 60% 50% at 100% 100%, rgba(95, 224, 222, 0.08), transparent 60%),
      var(--surface);
  }

  .idtl { list-style: none; margin-top: var(--space-xl); display: flex; flex-direction: column; gap: var(--space-2xl); }
  .idtl__num { font-size: var(--font-xs); font-weight: 700; color: var(--accent); letter-spacing: 0.06em; }
  .idtl__label { font-size: var(--font-md); font-weight: 700; margin-top: var(--space-xs); margin-bottom: var(--space-xs); }
  .idtl__line { font-size: 1.125rem; line-height: 1.6; max-width: 44rem; margin-bottom: var(--space-md); }
  .idtl__visual :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-width: 38rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
  }
  .idtl__visual--pad :global(img) { padding: var(--space-lg); background: var(--surface); }
  .idtl__visual--final :global(img) { max-width: 100%; }
  .idtl__stage--final { padding-top: var(--space-xl); border-top: 1px solid var(--hairline); }

  /* Thyroxine mark: the one image worth making a hero of */
  .idtl__visual--glow {
    display: inline-block;
    padding: 3px;
    border-radius: calc(var(--radius-md) + 3px);
    background: linear-gradient(135deg, var(--kaira-indigo), var(--kaira-teal));
    box-shadow: 0 0 50px 8px rgba(75, 79, 224, 0.22), 0 0 70px 14px rgba(95, 224, 222, 0.14);
  }
  .idtl__visual--glow :global(img) {
    border: none;
    border-radius: var(--radius-md);
  }

  /* Molecule pattern: a small swatch, not a full-bleed tile */
  .idtl__visual--band { width: 18rem; }
  .idtl__visual--band :global(img) {
    width: 18rem;
    max-width: 18rem;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: top left;
  }

  /* ---- Killed / shelved block ---- */
  .killed {
    margin-top: var(--space-xl);
    padding: var(--space-lg);
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-md);
    background: rgba(231, 95, 56, 0.04);
  }
  .killed__tag {
    display: inline-block;
    font-size: var(--font-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-sm);
  }
  .killed__lead { font-weight: 700; margin-bottom: var(--space-2xs); }
  .killed__text p { font-size: 1.125rem; line-height: 1.6; }
  .killed__shot {
    display: block;
    width: min(40rem, 100%);
    margin: var(--space-lg) auto 0;
  }
  .killed__img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--hairline);
    border-radius: calc(var(--radius-md) - 4px);
  }

  /* ---- Hooked loop (quiet variant, mirrors the CGM page) ---- */
  .hooked { margin-top: var(--space-xl); display: flex; align-items: stretch; gap: var(--space-md); }
  .hooked--quiet .hooked__stage {
    flex: 1;
    padding: var(--space-md);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    text-align: center;
  }
  .hooked__title { font-size: var(--font-sm); font-weight: 700; margin-bottom: var(--space-2xs); }
  .hooked__desc { font-size: var(--font-sm); color: var(--muted); }
  .hooked__arrow { flex-shrink: 0; display: flex; align-items: center; color: var(--accent); }
  .hooked__arrow svg { width: 1.1rem; height: 1.1rem; }
  @media (max-width: 48rem) {
    .hooked { flex-direction: column; }
  }

  /* ---- Findings (learnings section) ---- */
  .findings { margin-top: var(--space-xl); display: flex; flex-direction: column; gap: var(--space-2xl); }
  .finding__h { font-size: 1.125rem; font-weight: 700; margin-bottom: var(--space-xs); }
  .finding p { font-size: 1.125rem; line-height: 1.6; max-width: 46rem; }
  .finding__stat {
    margin-top: var(--space-md);
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-lg);
    background: rgba(231, 95, 56, 0.04);
    border: 1px solid rgba(231, 95, 56, 0.18);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-md);
  }
  .finding__fig {
    flex-shrink: 0;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
  }
  .finding__statbody { display: flex; flex-direction: column; gap: var(--space-xs); }
  .finding__label { font-size: 1.125rem; line-height: 1.5; max-width: 34rem; }
  .finding__base { display: inline-block; width: fit-content; }
  @media (max-width: 30rem) {
    .finding__stat { flex-direction: column; align-items: flex-start; }
  }

  /* ---- VIZ-07: input mode split ---- */
  .viz07 { margin-top: var(--space-md); display: flex; flex-direction: column; gap: var(--space-xs); }
  .viz07__bar {
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-pill);
    font-size: var(--font-sm);
    font-weight: 700;
    color: #fff;
  }
  .viz07__bar--text { background: var(--ink); }
  .viz07__bar--camera { background: var(--muted); }
  .viz07__bar--voice { background: var(--accent); }

  /* ---- Roadmap list ---- */
  .roadmap-list { list-style: none; margin-top: var(--space-xl); display: flex; flex-direction: column; gap: var(--space-2xl); }
  .roadmap-item__tag {
    display: inline-block;
    font-size: var(--font-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-sm);
  }
  .roadmap-item__tag--awareness { color: var(--muted); border-color: var(--muted); }
  .roadmap-item__tag--retention { color: var(--muted); border-color: var(--muted); }
  .roadmap-item__h { font-size: 1.125rem; font-weight: 700; margin-bottom: var(--space-xs); }
  .roadmap-item p { font-size: 1.125rem; line-height: 1.6; max-width: 46rem; margin-bottom: var(--space-md); }

  /* ---- Manual logging wireframe demo ---- */
  .manual-demo { margin-top: var(--space-md); }
  .manual-demo__video {
    display: block;
    width: 100%;
    max-width: 18rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    box-shadow: 0 16px 34px rgba(0, 0, 0, 0.1);
    background: var(--surface);
  }
  .manual-demo__cap {
    margin-top: var(--space-sm);
    max-width: 18rem;
    font-size: var(--font-sm);
    font-style: italic;
    color: var(--muted);
    line-height: 1.5;
  }

  /* ---- Simplified IA: five tabs, two redrawn ---- */
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&display=swap');
  .ia { margin-top: var(--space-md); max-width: 46rem; }
  .ia__bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    padding: var(--space-md) var(--space-sm);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .ia__tab {
    flex: 1 1 5.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    padding: var(--space-sm) var(--space-2xs);
    border-radius: var(--radius-md);
    text-align: center;
  }
  .ia__tab--changed {
    background: rgba(231, 95, 56, 0.06);
    border: 1px dashed rgba(231, 95, 56, 0.35);
  }
  .ia__was {
    position: relative;
    display: inline-block;
    font-size: var(--font-base);
    font-weight: 700;
    color: var(--muted);
  }
  .ia__was::after {
    content: '';
    position: absolute;
    left: -8%;
    right: -8%;
    top: 50%;
    height: 3px;
    background: var(--accent);
    border-radius: 2px;
    transform: translateY(-50%) rotate(-8deg);
  }
  .ia__icon svg { display: block; width: 1.3rem; height: 1.3rem; color: var(--muted); }
  .ia__tab--changed .ia__icon svg { color: var(--accent); }
  .ia__name { font-size: var(--font-sm); font-weight: 700; color: var(--ink); }
  .ia__notes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
    padding-top: var(--space-xs);
  }
  .ia__note {
    --rot: 0deg;
    position: relative;
    width: 13rem;
    padding: var(--space-md) var(--space-md) var(--space-lg);
    background: #FFF3B0;
    border-radius: 2px;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.12), 0 2px 4px rgba(0, 0, 0, 0.08);
    transform: rotate(var(--rot));
    font-family: 'Caveat', cursive;
  }
  .ia__note::before {
    content: '';
    position: absolute;
    top: -0.6rem;
    left: 50%;
    width: 3rem;
    height: 1.1rem;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(0, 0, 0, 0.05);
    transform: translateX(-50%) rotate(-3deg);
  }
  .ia__note strong {
    display: block;
    font-size: 1.4rem;
    line-height: 1;
    margin-bottom: 0.25rem;
    color: #7A5B00;
  }
  .ia__note p {
    font-family: 'Caveat', cursive;
    font-size: 1.25rem;
    line-height: 1.25;
    color: #4A3A00;
    max-width: none;
  }

  /* ---- VIZ-08: four pillars ---- */
  .viz08 { margin-top: var(--space-md); }
  .viz08__flag {
    display: inline-block;
    font-size: var(--font-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px dashed var(--hairline);
    border-radius: var(--radius-pill);
    padding: 0.15rem 0.6rem;
    margin-bottom: var(--space-sm);
  }
  .viz08__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-md); }
  .viz08__pillar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-lg) var(--space-md);
    border: 1px solid rgba(231, 95, 56, 0.2);
    border-radius: var(--radius-md);
    background: rgba(231, 95, 56, 0.05);
    text-align: center;
  }
  .viz08__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    box-shadow: 0 6px 16px rgba(231, 95, 56, 0.3);
  }
  .viz08__icon svg { width: 1.5rem; height: 1.5rem; }
  .viz08__name { font-size: var(--font-sm); font-weight: 700; color: var(--ink); }
  @media (max-width: 40rem) {
    .viz08__grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* ---- Cross link ---- */
  .crosslink-lead {
    margin-top: var(--space-3xl);
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--ink);
    max-width: 46rem;
  }
  .crosslink {
    margin-top: var(--space-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-lg);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .crosslink:hover { border-color: var(--accent); transform: translateY(-2px); }
  .crosslink__label { font-size: 1.125rem; font-weight: 700; }
  .crosslink__cta { font-size: var(--font-sm); font-weight: 600; color: var(--accent); white-space: nowrap; }

  /* ---- Lightbox ---- */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.85);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
    padding: var(--space-xl);
  }
  .lb[data-open='true'] { opacity: 1; pointer-events: auto; }
  .lb__stage { display: flex; align-items: center; justify-content: center; max-width: 100%; max-height: 80vh; }
  .lb__img {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border-radius: var(--radius-md);
    cursor: zoom-in;
  }
  .lb__img.is-zoomed { max-width: none; max-height: none; cursor: zoom-out; }
  .lb__cap { margin-top: var(--space-md); max-width: 44rem; text-align: center; font-size: var(--font-sm); color: rgba(255, 255, 255, 0.75); }
  .lb__close {
    position: absolute;
    top: var(--space-lg);
    right: var(--space-lg);
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 1.1rem;
    cursor: pointer;
  }

  @media (max-width: 40rem) {
    .viz01, .viz02, .viz03, .viz04, .viz05, .forkviz { overflow-x: auto; }
  }
</style>

<script>
  const lb = document.querySelector<HTMLElement>('.lb');
  if (lb) {
    const img = lb.querySelector<HTMLImageElement>('.lb__img')!;
    const cap = lb.querySelector<HTMLElement>('.lb__cap')!;
    const stage = lb.querySelector<HTMLElement>('[data-lb-stage]')!;

    function open(src: string, caption: string) {
      img.src = src;
      img.classList.remove('is-zoomed');
      cap.textContent = caption;
      lb.dataset.open = 'true';
      document.body.style.overflow = 'hidden';
    }
    function close() {
      lb.dataset.open = 'false';
      img.removeAttribute('src');
      document.body.style.overflow = '';
    }

    document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        open(el.dataset.lightbox || '', el.dataset.caption || '');
      });
    });

    img.addEventListener('click', () => img.classList.toggle('is-zoomed'));
    stage.addEventListener('click', (e) => {
      if (e.target === stage) close();
    });
    lb.querySelector('[data-lb-close]')!.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lb.dataset.open === 'true') close();
    });
  }
</script>
