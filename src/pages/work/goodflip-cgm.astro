---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AssetPlaceholder from '../../components/AssetPlaceholder.astro';
import KilledIdeaMock from '../../components/KilledIdeaMock.astro';
import TheBet from '../../components/TheBet.astro';
import DeviceTimeline from '../../components/DeviceTimeline.astro';
import IAWireframe from '../../components/IAWireframe.astro';
import ReaderViewFlow from '../../components/ReaderViewFlow.astro';
import cgmHero from '../../assets/cgm-hero.png';
import cgmContextGoodflip from '../../assets/cgm-context-goodflip.png';
import cgmContextCgm from '../../assets/cgm-context-cgm.png';
import cgmMetricCards from '../../assets/cgm-metric-cards.png';
import cgmEducation from '../../assets/cgm-education.png';
import cgmNudges from '../../assets/cgm-nudges.png';
import cgmSyncError from '../../assets/cgm-sync-error.png';
import cgmReplica from '../../assets/cgm-replica.png';
import cgmConnection from '../../assets/cgm-connection.png';
import cgmQrBefore from '../../assets/cgm-qr-before.png';
import cgmQrAfter from '../../assets/cgm-qr-after.png';
import cgmHindiBefore from '../../assets/cgm-hindi-before.png';
import cgmHindiAfter from '../../assets/cgm-hindi-after.png';
import cgmAiGraph from '../../assets/cgm-ai-graph.png';
import cgmAiDaily from '../../assets/cgm-ai-daily.png';
import cgmAiSpike from '../../assets/cgm-ai-spike.png';
import cgmExpDailyCumulative from '../../assets/cgm-exp-daily-cumulative.png';
import cgmExpAdvanced from '../../assets/cgm-exp-advanced.png';
import cgmExpEducation from '../../assets/cgm-exp-education.png';
import cgmExpDailyInsight from '../../assets/cgm-exp-daily-insight.png';
import cgmExpSyncPaused from '../../assets/cgm-exp-sync-paused.png';

const beat5 = {
  metricCards: { src: cgmMetricCards, alt: 'Metric cards ending on a human verdict: Time in Range 76% you’re on track, Time Above Range 18% room to improve' },
  education: { src: cgmEducation, alt: 'An education page explaining what the day glucose graph means and how to read it, in plain language' },
  nudges: { src: cgmNudges, alt: 'The nudge system table: trigger, timing, user state, and message, led by glucose-spike nudges' },
  syncError: { src: cgmSyncError, alt: 'An in-context Sync Paused error telling the user to check the transmitter is properly fitted' },
  replica: { src: cgmReplica, alt: 'A live on-screen replica of the CGM device showing the current glucose reading' },
  connection: { src: cgmConnection, alt: 'Connection support: a sensor warming-up screen with a CGM guide and video tutorials' },
};

const KAIRA_HREF = '/work/food-logging-with-kaira';

const payoffs = [
  {
    key: 'user',
    label: 'User',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/></svg>`,
    body: 'You see your own glucose patterns and catch spikes early. You know where you stand today, instead of waiting six months for a lab to tell you.',
  },
  {
    key: 'ecosystem',
    label: 'Product / ecosystem',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="9" y1="4" x2="9" y2="22"/></svg>`,
    body: 'It fills the silence between six-month lab tests. Your effort finally has a mirror in the moment, not a verdict half a year later.',
  },
  {
    key: 'clinical',
    label: 'Clinical / coaching',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M9 14l2 2 4-4"/></svg>`,
    body: 'Your coach acts on real days, not twice-a-year snapshots, so the guidance fits the life you’re actually living.',
  },
];

const metrics = [
  {
    metric: 'Time in range',
    call: 'Show',
    tone: 'show',
    why: 'Upfront, never buried. The one number that answers am I okay.',
  },
  {
    metric: 'GMI',
    call: 'Simplify',
    tone: 'simplify',
    why: 'Renamed “Glucose Estimate” with a tooltip. The acronym means nothing to most people.',
  },
  {
    metric: 'Max fluctuation',
    call: 'Withhold',
    tone: 'withhold',
    why: 'Held back from the everyday user. A lone alarming spike doesn’t inform them, it frightens them. It lives in the advanced view, where a coach reads it in context.',
  },
];


// Shipped interactive prototypes (Figma). Session tokens stripped.
const protos = [
  {
    label: 'Onboarding journey',
    url: 'https://www.figma.com/proto/L8LwpJoeVQ67IGvsiU7eha/GF-CGM-Onboarding?node-id=3-9681&scaling=scale-down&content-scaling=fixed&starting-point-node-id=3%3A8352&page-id=2%3A21',
  },
  {
    label: 'Main landing page',
    url: 'https://www.figma.com/proto/vpNbjYQVD5VEKL6R38CNEF/Kaira-s-CGM-Insights?node-id=243-11801&scaling=scale-down&content-scaling=fixed&starting-point-node-id=243%3A11830&page-id=1%3A3',
  },
].map((p) => ({
  ...p,
  embed: `https://www.figma.com/embed?embed_host=share&url=${encodeURIComponent(p.url)}`,
}));

// Prototype embedded in the "Experience the CGM" dark section. Session token stripped.
const onboardingProtoUrl = 'https://www.figma.com/proto/sY16NS7f8q4lw8QxmYskkc/GoodFlip-Retrospective?node-id=12-3512&viewport=-348%2C203%2C0.15&scaling=scale-down&content-scaling=fixed&page-id=1%3A3068';
const onboardingProtoEmbed = `https://www.figma.com/embed?embed_host=share&url=${encodeURIComponent(onboardingProtoUrl)}`;
---

<BaseLayout
  title="Turning clinical data into metabolic health anyone can read | Daksh Sharma"
  description="Case study: a live glucose dashboard built for three kinds of reader. Sole product designer, research to shipped UI, GoodFlip CGM (TatvaCare)."
>
  <article class="cs">
    <a class="cs__back" href="/#work">← Back to work</a>

    <figure class="shot shot--hero">
      <Image
        class="cs__hero-img"
        src={cgmHero}
        alt="GoodFlip CGM app: daily glucose metrics, the device onboarding screen, and a Kaira spike insight"
        widths={[900, 1440, 2000, 3360]}
        sizes="min(60rem, 92vw)"
        loading="eager"
        fetchpriority="high"
      />
    </figure>

    {/* BEAT 1 — ANCHOR */}
    <header class="cs__anchor">
      <h1 class="cs__title">Turning clinical data into metabolic health anyone can read</h1>
    </header>

    <section class="context">
      <h2 class="context__heading">Let's start with some context</h2>
      <div class="context__grid">
        <div class="context__col">
          <figure class="context__fig">
            <Image class="context__img" src={cgmContextGoodflip} alt="What GoodFlip is: an overview of its metabolic health platform" widths={[144, 216]} sizes="4.5rem" />
          </figure>
          <h3 class="context__title">What's GoodFlip</h3>
          <p class="context__desc">
            GoodFlip is a metabolic health platform that empowers users to manage
            metabolic conditions like obesity, fatty liver, diabetes, and PCOS
            through doctor-led programs, nutraceuticals, smart devices, advanced
            diagnostics, and personalized coaching.
          </p>
        </div>
        <div class="context__col">
          <figure class="context__fig">
            <Image class="context__img" src={cgmContextCgm} alt="What a CGM is: a wearable device tracking glucose levels day and night" widths={[144, 216]} sizes="4.5rem" />
          </figure>
          <h3 class="context__title">What's a CGM</h3>
          <p class="context__desc">
            A Continuous Glucose Monitor (CGM) is a small, wearable device that
            tracks your body's glucose (sugar) levels day and night.
          </p>
        </div>
      </div>
    </section>

    <section class="highlights">
      <h2 class="highlights__heading">Highlights of the project</h2>
      <div class="highlights__grid">
        <div class="highlights__card">
          <p class="highlights__value">77.6%</p>
          <p class="highlights__label">of people are able to complete the onboarding and connect with their CGM</p>
        </div>
        <div class="highlights__card">
          <p class="highlights__value">78%</p>
          <p class="highlights__label">of the people come back at day 15 to check their vitals</p>
        </div>
      </div>
    </section>

    {/* MY ROLE */}
    <section class="beat">
      <h2 class="beat__h">My role in the project</h2>
      <p>
        I was the sole designer on GoodFlip's CGM, owning it end to end: the
        initial research and success metrics, the onboarding and core metrics
        dashboard, and the post-launch data that told me what to fix next.
        Working alongside the clinical team to get the medical detail right
        and pitching direction to stakeholders, I shipped the MVP, then used
        what the launch data showed to rework the flow, adding an AI-powered
        read of each user's day and their glucose spikes.
      </p>
    </section>

    {/* EXPERIENCE THE CGM: a plain full-bleed dark section */}
    <section class="experience" id="experience-cgm">
      <h2 class="experience__title">Experience the GoodFlip CGM</h2>

      <div class="experience__content">
        <article class="exp-card">
          <h3 class="exp-card__title">Your story</h3>
          <p class="exp-card__intro">
            Imagine you're on your fitness journey, and you're having trouble
            knowing which foods react how with your body. You see an
            intelligent way to track your blood glucose on Instagram, and you
            order our device. You open the app and continue your journey from
            here.
          </p>

          <ol class="exp-steps">
            <li class="exp-step">
              <span class="exp-step__num">1</span>
              <p class="exp-step__text">You want to track your glucose data for your fitness journey.</p>
            </li>
            <li class="exp-step">
              <span class="exp-step__num">2</span>
              <p class="exp-step__text">You see a GoodFlip ad and purchase our device.</p>
            </li>
            <li class="exp-step">
              <span class="exp-step__num">3</span>
              <p class="exp-step__text">You install the app and continue your journey from here.</p>
            </li>
          </ol>
        </article>

        <div class="exp-pointer" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="18"/><polyline points="6 12 12 18 18 12"/></svg>
        </div>

        <article class="exp-card">
          <h3 class="exp-card__title">CGM onboarding flow</h3>
          <div class="exp-proto">
            <iframe
              src={onboardingProtoEmbed}
              title="Interactive Figma prototype: CGM onboarding flow"
              loading="lazy"
              allowfullscreen
            ></iframe>
          </div>
        </article>

        <div class="exp-pointer" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="18"/><polyline points="6 12 12 18 18 12"/></svg>
        </div>

        {/* Block 1 — the spine of this section: one dashboard, three depths */}
        <article class="exp-card exp-card--hero">
          <div class="hero-split" aria-hidden="true">
            <span class="hero-split__seg">
              <strong>Daily</strong>
              <small>the shared starting point</small>
            </span>
            <span class="hero-split__seg">
              <strong>Cumulative</strong>
              <small>trends and progress</small>
            </span>
            <span class="hero-split__seg">
              <strong>Advanced</strong>
              <small>the clinical layer</small>
            </span>
          </div>
          <div class="hero-images">
            <Image class="hero-images__wide" src={cgmExpDailyCumulative} alt="The Daily Metrics and Cumulative Report views side by side, the shared home screen and the trend view" widths={[500, 700]} sizes="(max-width: 48rem) 92vw, 26rem" />
            <Image class="hero-images__narrow" src={cgmExpAdvanced} alt="The Advanced Metrics view: estimated HbA1c, glucose variability, and other clinical-depth numbers" widths={[300, 420]} sizes="(max-width: 48rem) 60vw, 16rem" />
          </div>
          <h3 class="exp-card__title">One dashboard, three ways to read it</h3>
          <p class="exp-card__intro">
            The same glucose data, split into three depths for three readers:
            a daily glance, a cumulative trend, and a clinical layer. Each
            person lands on their own view without ever standing in someone
            else's.
          </p>
        </article>

        <div class="exp-pointer" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="18"/><polyline points="6 12 12 18 18 12"/></svg>
        </div>

        {/* Block 2 — education pages, a deliberate bet */}
        <article class="exp-card">
          <Image class="exp-card__img" src={cgmExpEducation} alt="An education page breaking down Time Above Range and a How to Read It explainer with a labelled glucose chart" widths={[500, 700]} sizes="(max-width: 48rem) 92vw, 26rem" />
          <h3 class="exp-card__title">A bet on curiosity</h3>
          <p class="exp-card__intro">
            We chose to teach, not just display. Every clinical term gets
            what it means, what good looks like, and how to read it.
          </p>
          <p class="exp-card__stat">
            <span class="exp-card__stat-fig">42%</span>
            <span class="exp-card__stat-label">of users opened at least one education screen</span>
          </p>
        </article>

        <div class="exp-pointer" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="18"/><polyline points="6 12 12 18 18 12"/></svg>
        </div>

        {/* Block 3 — daily insight and the AI meal read */}
        <article class="exp-card">
          <Image class="exp-card__img" src={cgmExpDailyInsight} alt="The daily metrics screen opening into a Daily Insight card explaining an uneven glucose rhythm and prompting a meal log" widths={[500, 700]} sizes="(max-width: 48rem) 92vw, 26rem" />
          <h3 class="exp-card__title">From what happened to why</h3>
          <p class="exp-card__intro">
            The dashboard shows the spikes. Kaira explains them in plain
            language tied to real meals, then prompts a log so tomorrow's
            read gets sharper.
          </p>
        </article>

        <div class="exp-pointer" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="18"/><polyline points="6 12 12 18 18 12"/></svg>
        </div>

        {/* Block 4 — Sync Paused, a systems-thinking decision */}
        <article class="exp-card">
          <Image class="exp-card__img" src={cgmExpSyncPaused} alt="A Sync Paused error card asking the user to check the transmitter is properly fitted on the sensor" widths={[500, 700]} sizes="(max-width: 48rem) 92vw, 26rem" />
          <h3 class="exp-card__title">Designing for failure, not just success</h3>
          <p class="exp-card__intro">
            The error states weren't an afterthought. Building them as a
            reusable system meant that when we later designed for other
            devices like the Ring, the same failure-handling was already in
            place to catch issues early.
          </p>
        </article>

        <div class="exp-pointer" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="18"/><polyline points="6 12 12 18 18 12"/></svg>
        </div>

        <article class="exp-card">
          <h3 class="exp-card__title">Who reaches for which view</h3>
          <ReaderViewFlow />
        </article>
      </div>
    </section>

    {/* PROBLEM STATEMENT */}
    <section class="problem">
      <div class="problem__inner">
        <h2 class="problem__heading">Problem statement</h2>
        <p class="problem__text">
          Users dealing with metabolic conditions often rely on advice from
          experts and have to continue doing dedicated tasks with discipline,
          without any visible progress for significant periods of time. The
          CGM gives users the ability to track their body's vitals and build
          more personalized plans.
        </p>
        <p class="problem__text problem__text--highlight">
          The challenge here was to design an experience that created meaning
          out of medical terms for the average user without overwhelming
          them, keeping in mind that GoodFlip was aiming to serve a wide
          variety of users with different needs.
        </p>
      </div>
    </section>

    <hr class="cs__divider" />

    {/* BEAT 2 — WHY CGM (3-beat narrative) */}
    <section class="whycgm" id="why-cgm">
      {/* Beat 1 — The setup */}
      <h2 class="whycgm__heading">Why CGM</h2>
      <div class="whycgm__setup">
        <p class="whycgm__setup-text">
          CGM was a product call, a commercial one. A standalone SKU in a growing
          market (BeatO, Ultrahuman, SugarFit) with a natural 15-day repurchase cycle.
          The business case was sound.
        </p>
      </div>

      {/* Beat 2 — The pivot (hero moment) */}
      <blockquote class="whycgm__pivot">
        <p>
          But a business case greenlights a product. It doesn't make it worth wearing.
          So before I designed against the call, I pressure-tested it: does continuous
          glucose actually change how someone experiences their own body, or is it just
          a device we sell every fifteen days?
        </p>
        <p>I backed it once I was sure it was both.</p>
      </blockquote>

      {/* Beat 3 — The payoff */}
      <p class="whycgm__leadin">Here's what convinced me.</p>
      <ul class="whycgm__payoffs">
        {payoffs.map((p) => (
          <li class={`payoff payoff--${p.key}`}>
            <span class="payoff__icon" aria-hidden="true" set:html={p.icon} />
            <h3 class="payoff__label">{p.label}</h3>
            <p class="payoff__body">{p.body}</p>
          </li>
        ))}
      </ul>
    </section>

    {/* ── Divider ── */}
    <div class="cs__section-break" aria-hidden="true">
      <span class="cs__section-break-line"></span>
      <span class="cs__section-break-dot"></span>
      <span class="cs__section-break-line"></span>
    </div>

    {/* BEAT 3 — BEFORE THE SCREEN (three-phase timeline) */}
    <section class="beat" id="before-the-screen">
      <h2 class="beat__h">I got close from three distances</h2>
      <p>
        Before I designed a screen, I got close to this product three ways: the domain, the device, and the whole journey.
      </p>
    </section>

    <DeviceTimeline />

    {/* ── Divider ── */}
    <div class="cs__section-break" aria-hidden="true">
      <span class="cs__section-break-line"></span>
      <span class="cs__section-break-dot"></span>
      <span class="cs__section-break-line"></span>
    </div>

    {/* BEAT 4 — THE BET (CENTERPIECE) */}
    <TheBet />

    <section class="beat">
      <p>
        Inside each view I made one more call, metric by metric. Show it, simplify
        it, or hold it back.
      </p>
    </section>

    <div class="mtable-wrap">
      <p class="mtable-title">The per-metric call</p>
      <table class="mtable">
        <thead>
          <tr><th>Metric</th><th>Call</th><th>Why</th></tr>
        </thead>
        <tbody>
          {metrics.map((m) => (
            <tr>
              <td class="mtable__metric">{m.metric}</td>
              <td><span class={`mtag mtag--${m.tone}`}>{m.call}</span></td>
              <td class="mtable__why">{m.why}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <section class="beat">
      <p class="beat__lead">
        The question was never how much to show. It was what each person could act
        on, and what would only scare them.
      </p>
    </section>

    {/* BEAT 5 — WHAT I BUILT IN RESPONSE
    Commented out for now while this section gets reworked. Do not delete, restore when ready.
    <section class="beat">
      <h2 class="beat__h">Legible data, trustworthy device</h2>
      <p>
        That list of everything that can go wrong became the brief. I built
        against it in two directions: making the data legible, and making the
        device trustworthy.
      </p>
    </section>

    <div class="protos">
      {protos.map((p) => (
        <figure class="proto">
          <figcaption class="proto__label">{p.label}</figcaption>
          <div class="proto__frame">
            <iframe
              src={p.embed}
              title={`Interactive Figma prototype: GoodFlip CGM ${p.label}`}
              loading="lazy"
              allowfullscreen
            ></iframe>
          </div>
        </figure>
      ))}
    </div>

    <IAWireframe />

    <section class="beat">
      <h3 class="beat__sub">Making the data legible</h3>
    </section>

    <ul class="b5">
      <li class="b5-item">
        <h4 class="b5-item__title">Plain-language cards</h4>
        <p class="b5-item__desc">
          Every metric card ends on a human verdict, not just a number. 18% above
          range reads as “room to improve.”
        </p>
        <figure class="b5-item__fig b5-item__fig--wide">
          <Image class="b5-item__img" src={beat5.metricCards.src} alt={beat5.metricCards.alt} widths={[600, 1200, 1754]} sizes="(max-width: 48rem) 92vw, 44rem" />
        </figure>
      </li>

      <li class="b5-item">
        <h4 class="b5-item__title">Education pages</h4>
        <p class="b5-item__desc">
          For every metric a user might not understand, a page that explains what
          it means and how to read it, in plain language before clinical terms.
          This is the decision I can prove worked, see the numbers below. People
          didn’t tolerate the education. They sought it out.
        </p>
        <figure class="b5-item__fig b5-item__fig--portrait">
          <Image class="b5-item__img" src={beat5.education.src} alt={beat5.education.alt} widths={[400, 750]} sizes="(max-width: 48rem) 92vw, 20rem" />
        </figure>
      </li>

      <li class="b5-item">
        <h4 class="b5-item__title">The nudge system</h4>
        <p class="b5-item__desc">
          The thing that helped me most during my fifteen days, designed as a
          system rather than a stream of alerts. Seven triggers, each tuned to what
          the moment can bear: a low-glucose dip is cautious and actionable, a
          night spike is quietly informative, the end of a spiky day is reflective,
          not alarming. Same duty of care as the dashboard itself, applied to what
          we say and when.
        </p>
        <figure class="b5-item__fig b5-item__fig--wide">
          <Image class="b5-item__img" src={beat5.nudges.src} alt={beat5.nudges.alt} widths={[600, 1200, 2022]} sizes="(max-width: 48rem) 92vw, 44rem" />
        </figure>
      </li>

      <li class="b5-item b5-item--highlight">
        <h4 class="b5-item__title">In-context error states</h4>
        <p class="b5-item__desc">
          When syncing dropped, the screen said what to check and why, in place,
          rather than leaving the user staring at missing data.
        </p>
        <div class="b5-highlight">
          <div class="b5-highlight__tag b5-highlight__tag--origin">
            <span class="b5-highlight__pill">From the 15 days</span>
            <span class="b5-highlight__line">"Data dropped out and I couldn't tell if it was me, the sensor, or the app."</span>
          </div>
          <figure class="b5-item__fig b5-item__fig--portrait">
            <Image class="b5-item__img" src={beat5.syncError.src} alt={beat5.syncError.alt} widths={[400, 980]} sizes="(max-width: 48rem) 92vw, 20rem" />
          </figure>
          <div class="b5-highlight__tag b5-highlight__tag--constraint">
            <span class="b5-highlight__pill b5-highlight__pill--muted">The honest constraint</span>
            <span class="b5-highlight__line b5-highlight__line--muted">Moisture and distance dropouts heal on their own, so the copy says "it'll resume," not "re-pair everything."</span>
          </div>
        </div>
      </li>

      <li class="b5-item">
        <h4 class="b5-item__title">Live CGM replica</h4>
        <p class="b5-item__desc">
          Marketing wanted to launch this as India’s first Bluetooth CGM. I turned
          that ask into a live on-screen replica of the device showing the current
          reading, so the data felt alive rather than buried in a table.
        </p>
        <figure class="b5-item__fig b5-item__fig--wide">
          <Image class="b5-item__img" src={beat5.replica.src} alt={beat5.replica.alt} widths={[500, 986]} sizes="(max-width: 48rem) 92vw, 44rem" />
        </figure>
      </li>

      <li class="b5-item">
        <h4 class="b5-item__title">Connection support</h4>
        <p class="b5-item__desc">
          Help, demos, and a way to reach support built into the connection journey
          itself, where the install actually got hard.
        </p>
        <figure class="b5-item__fig b5-item__fig--portrait">
          <Image class="b5-item__img" src={beat5.connection.src} alt={beat5.connection.alt} widths={[400, 590]} sizes="(max-width: 48rem) 92vw, 20rem" />
        </figure>
      </li>
    </ul>
    */}

    {/* BEAT 6 — THE RECKONING */}
    <section class="beat">
      <h2 class="beat__h">Then I looked at what happened</h2>
      <p>
        Six weeks after launch, the February 2026 data was in. I only claim what
        it can hold, so here’s what held.
      </p>
    </section>

    <div class="statblocks">
      <article class="statblock">
        <p class="statblock__fig">77.6%</p>
        <p class="statblock__claim">Finished setup: most onboarding bleeds users at every step. This mostly didn’t.</p>
        <div class="statblock__viz">
          <svg class="statblock__svg" viewBox="0 0 160 72" role="img" aria-label="Funnel: 100% start, 93% sensor, 83% transmitter detection (the cliff), 77.6% complete">
            <rect x="0" y="0" width="160" height="14" rx="3" fill="rgba(0,0,0,0.06)"/>
            <rect x="0" y="0" width="160" height="14" rx="3" fill="rgba(0,0,0,0.08)"/>
            <text x="4" y="10.5" font-size="7" fill="var(--muted)" font-family="system-ui,sans-serif">100%</text>

            <rect x="6" y="20" width="149" height="14" rx="3" fill="rgba(0,0,0,0.06)"/>
            <text x="10" y="30.5" font-size="7" fill="var(--muted)" font-family="system-ui,sans-serif">93% sensor paired</text>

            <rect x="12" y="40" width="133" height="14" rx="3" fill="rgba(231,95,56,0.15)"/>
            <rect x="12" y="40" width="133" height="14" rx="3" fill="none" stroke="var(--accent)" stroke-width="0.8"/>
            <text x="16" y="50.5" font-size="7" font-weight="600" fill="var(--accent)" font-family="system-ui,sans-serif">83% transmitter ← the cliff</text>

            <rect x="18" y="60" width="124" height="14" rx="3" fill="rgba(0,0,0,0.06)"/>
            <text x="22" y="70.5" font-size="7" fill="var(--muted)" font-family="system-ui,sans-serif">77.6% complete</text>
          </svg>
        </div>
        <details class="statblock__details">
          <summary>Context</summary>
          <p>218 of 281, ten-step two-part pairing flow. The 22% who fell = the same two-part device that bit us after launch.</p>
        </details>
      </article>

      <article class="statblock">
        <p class="statblock__fig">78%</p>
        <p class="statblock__claim">Still using it at day 14: they came back to read their data daily.</p>
        <div class="statblock__viz">
          <svg class="statblock__svg" viewBox="0 0 160 60" role="img" aria-label="Retention: Day 0 at 93%, Day 7 at 81%, Day 14 at 78%">
            <path d="M8 8 L80 30 L152 38 L152 52 L8 52 Z" fill="rgba(231,95,56,0.08)"/>
            <path d="M8 8 L80 30 L152 38" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="8" cy="8" r="3" fill="var(--accent)"/>
            <circle cx="80" cy="30" r="3" fill="var(--accent)"/>
            <circle cx="152" cy="38" r="3" fill="var(--accent)"/>
            <line x1="152" y1="38" x2="152" y2="4" stroke="var(--accent)" stroke-width="1" stroke-dasharray="3 3" opacity="0.5"/>
            <text x="8" y="56" font-size="7" fill="var(--muted)" font-family="system-ui,sans-serif">Day 0</text>
            <text x="72" y="56" font-size="7" fill="var(--muted)" font-family="system-ui,sans-serif">Day 7</text>
            <text x="136" y="56" font-size="7" fill="var(--accent)" font-weight="600" font-family="system-ui,sans-serif">Day 14</text>
          </svg>
        </div>
        <details class="statblock__details">
          <summary>Context</summary>
          <p>Held to day 14. Beyond that the cohorts thin and the number stops being trustworthy, so that’s the ceiling I claim.</p>
        </details>
      </article>

      <article class="statblock statblock--peak">
        <p class="statblock__fig">42%</p>
        <p class="statblock__claim">Opened the day-glucose explainer, the most-opened content on the dashboard.</p>
        <div class="statblock__viz">
          <svg class="statblock__svg" viewBox="0 0 160 52" role="img" aria-label="Day-glucose explainer 42% vs time-in-range explainer 24%">
            <rect x="0" y="4" width="108" height="18" rx="3" fill="var(--accent)"/>
            <text x="6" y="16" font-size="8" font-weight="600" fill="#fff" font-family="system-ui,sans-serif">42%</text>
            <text x="36" y="16" font-size="7" fill="rgba(255,255,255,0.85)" font-family="system-ui,sans-serif">day-glucose</text>

            <rect x="0" y="30" width="62" height="18" rx="3" fill="rgba(0,0,0,0.08)"/>
            <text x="6" y="42" font-size="8" font-weight="600" fill="var(--muted)" font-family="system-ui,sans-serif">24%</text>
            <text x="30" y="42" font-size="7" fill="var(--muted)" font-family="system-ui,sans-serif">time-in-range</text>
          </svg>
        </div>
        <details class="statblock__details">
          <summary>Context</summary>
          <p>People didn’t just glance at numbers: they stopped to learn what they meant. The one decision I most wanted to be right about.</p>
        </details>
      </article>
    </div>

    <section class="beat">
      <p class="beat__lead">The dashboard held. The onboarding was where reality pushed back.</p>
    </section>

    {/* BEAT 7 — WHERE REALITY PUSHED BACK */}
    <section class="beat">
      <h2 class="beat__h">The device didn’t behave</h2>
      <p>
        Setup completion said 77.6%. What it didn’t say: some of those completed
        setups started coming back as replacement requests. The data looked clean.
        The device, in people’s hands, wasn’t behaving.
      </p>
      <p>
        The complaints traced to one thing. It’s a two-component device (sensor and
        transmitter, assembled by the user), and despite clear instructions, people
        couldn’t tell when it was seated correctly. Data wouldn’t show, or they’d
        installed it slightly wrong, or it wasn’t attached properly.
      </p>
      <p>
        The root cause wasn’t the instructions. It was the mental model. Our
        audience was used to a single-piece, stick-it-on-and-forget device. A
        two-part assembly was a category they’d never met, and no amount of
        on-screen copy fixed a hardware expectation. (The funnel had already
        whispered this: transmitter detection was the one cliff in setup.)
      </p>
    </section>

    <section class="beat">
      <h3 class="beat__sub">Two responses, each matched to a specific failure</h3>
    </section>

    <ol class="fixes">
      <li class="fix">
        <h4 class="fix__lead">The QR scan kept failing</h4>
        <p>On the sensor mapping step, so I added manual code entry as a fallback.</p>
        <div class="beforeafter">
          <figure class="ba">
            <span class="ba__label">Before</span>
            <Image class="ba__img" src={cgmQrBefore} alt="Connect-sensor step with QR scan only, no manual fallback" widths={[300, 400]} sizes="11rem" />
          </figure>
          <div class="ba__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="18" y2="12"/><polyline points="12 6 18 12 12 18"/></svg>
          </div>
          <figure class="ba">
            <span class="ba__label ba__label--after">After</span>
            <Image class="ba__img" src={cgmQrAfter} alt="The same step with a Can’t scan the sensor QR? Enter ID Manually fallback added" widths={[300, 400]} sizes="11rem" />
          </figure>
        </div>
      </li>
      <li class="fix">
        <h4 class="fix__lead">Older users were arriving in numbers we hadn’t designed for</h4>
        <p>So I translated the whole flow to Hindi with a language toggle.</p>
        <div class="beforeafter">
          <figure class="ba">
            <span class="ba__label">Before</span>
            <Image class="ba__img" src={cgmHindiBefore} alt="Put-on-the-sensor step in English only" widths={[300, 400]} sizes="11rem" />
          </figure>
          <div class="ba__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="18" y2="12"/><polyline points="12 6 18 12 12 18"/></svg>
          </div>
          <figure class="ba">
            <span class="ba__label ba__label--after">After</span>
            <Image class="ba__img" src={cgmHindiAfter} alt="The same step with an English and Hindi language toggle added" widths={[300, 400]} sizes="11rem" />
          </figure>
        </div>
      </li>
    </ol>

    <div class="killed">
      <div class="killed__text">
        <span class="killed__tag">Killed idea</span>
        <p>
          I also pitched the more ambitious fix: use the phone camera as a live
          install assistant, guiding the user through seating the device in real
          time. I built a working demo. We killed it: dev bandwidth was thin, and
          more seriously, nobody could answer what happens if the assistant tells
          someone it’s seated correctly when it isn’t. On a medical device, a
          confident wrong answer is worse than no answer. So it stayed a prototype.
        </p>
      </div>
      <KilledIdeaMock />
    </div>

    {/* BEAT 8 — KAIRA ON CGM */}
    <section class="beat">
      <h2 class="beat__h">Building a better relatability for users with Kaira AI</h2>
      <p>
        Let's continue our story from above. Imagine that you are now able to
        track your blood glucose levels and see glucose fluctuations with
        every activity (eating, exercising, waking up, etc.) you do. You now
        have visibility, but your curious self wants to know more.
      </p>
    </section>

    <div class="thought-bubbles">
      <div class="thought-bubble">
        <p>How is it that a banana can spike my glucose so much?</p>
        <span class="thought-bubble__tail" aria-hidden="true"><i></i><i></i><i></i></span>
      </div>
      <div class="thought-bubble">
        <p>Are these spikes normal?</p>
        <span class="thought-bubble__tail" aria-hidden="true"><i></i><i></i><i></i></span>
      </div>
    </div>

    <div class="collage">
      <div class="collage__grid">
        <figure class="collage__item collage__item--main">
          <Image src={cgmAiGraph} alt="Daily glucose trend with food markers placed directly on the curve and an entry point into AI insights" widths={[500, 936]} sizes="(max-width: 48rem) 92vw, 24rem" />
        </figure>
        <figure class="collage__item">
          <Image src={cgmAiDaily} alt="A Kaira daily insight reading the day’s glucose rhythm and naming the meal that helped most" widths={[500, 762]} sizes="(max-width: 48rem) 92vw, 18rem" />
        </figure>
        <figure class="collage__item">
          <Image src={cgmAiSpike} alt="A Kaira spike insight explaining a 240 mg/dL rise after a meal, plainly and without alarm" widths={[500, 734]} sizes="(max-width: 48rem) 92vw, 18rem" />
        </figure>
      </div>
      <p class="collage__cap">
        Kaira on the CGM graph: food marked on the curve, and the plain-language
        insights users open.
      </p>
    </div>

    <section class="beat">
      <p>
        I figured there had to be a way to answer these questions a user
        might naturally have. This is where we introduced Kaira on the CGM
        dashboard, with the following aims:
      </p>
      <ol class="hooked-aims">
        <li>Provide insights to the user that helped them understand why things are happening the way they are, not just what.</li>
        <li>Create a habit of food logging, allowing users to track meals as well, because what can be tracked can be improved. We used the Hooked Model to achieve this.</li>
      </ol>
      <h3 class="beat__sub">The Hooked Model</h3>
    </section>

    <div class="hooked">
      <div class="hooked__stage">
        <span class="hooked__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        </span>
        <h4 class="hooked__title">Trigger</h4>
        <p class="hooked__desc">A notification or Kaira's message on the CGM dashboard.</p>
      </div>
      <div class="hooked__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="18" y2="12"/><polyline points="12 6 18 12 12 18"/></svg>
      </div>
      <div class="hooked__stage">
        <span class="hooked__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        </span>
        <h4 class="hooked__title">Action</h4>
        <p class="hooked__desc">Log a meal using Kaira, or manually.</p>
      </div>
      <div class="hooked__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="18" y2="12"/><polyline points="12 6 18 12 12 18"/></svg>
      </div>
      <div class="hooked__stage">
        <span class="hooked__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </span>
        <h4 class="hooked__title">Variable reward</h4>
        <p class="hooked__desc">Receive instant insights about why spikes are happening.</p>
      </div>
      <div class="hooked__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="18" y2="12"/><polyline points="12 6 18 12 12 18"/></svg>
      </div>
      <div class="hooked__stage">
        <span class="hooked__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
        </span>
        <h4 class="hooked__title">Investment</h4>
        <p class="hooked__desc">Daily meal logging that results in better overall understanding and guidance.</p>
      </div>
    </div>

    <div class="evidence">
      <p class="evidence__fig">26%</p>
      <p class="evidence__label">
        of all logging starts came through the CGM screen, the second-largest
        food-logging doorway in the entire app, behind only the nutrition
        screen built specifically for it. A glucose dashboard turned into one
        of the product’s primary places to log a meal.
      </p>
    </div>

    <a class="crosslink" href={KAIRA_HREF}>
      <span class="crosslink__label">Kaira as a product has its own story</span>
      <span class="crosslink__cta">Read the Kaira case study<span aria-hidden="true"> →</span></span>
    </a>

    {/* HEADING INTO THE FUTURE */}
    <section class="beat">
      <h2 class="beat__h">Heading into the future</h2>
      <p>
        This project was really special. It put GoodFlip on the map alongside
        other health-tech platforms. From a design perspective, I gained
        experience drafting data-rich experiences that people actually use and
        enjoy.
      </p>
      <p>
        A designer is always stuck in a perpetual loop toward perfection, and
        the team is already taking significant steps toward a more robust
        experience. Some of my ideas and the work ahead include the following.
      </p>
    </section>

    <div class="future-wrap">
      <table class="future-table">
        <thead>
          <tr>
            <th>
              <span class="future-table__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              </span>
              What's in the pipeline?
            </th>
            <th>
              <span class="future-table__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              </span>
              What am I actively pitching to the team?
            </th>
            <th>
              <span class="future-table__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </span>
              What's my north star?
            </th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>
              <ol>
                <li>A better report-sharing experience, letting professionals handle multiple patients without being overwhelmed.</li>
                <li>Kaira gaining the ability to have two-way engagement with the user.</li>
              </ol>
            </td>
            <td>
              The whole product argued "show the right depth." The next bet is
              that showing isn't enough. Next, the system should be smart enough
              to customize a plan that actually helps you make valuable
              lifestyle changes.
            </td>
            <td>
              As a designer, I want users to actually understand how they're
              performing, and to communicate a motivating, transformative
              message through my work. I'd like this to become the definitive
              experience for viewing CGM data for everyday users, and a
              standard across the industry. We're far from that goal, but a
              designer can dream.
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    {/* TESTIMONIALS */}
    <section class="testimonials">
      <div class="testimonials__inner">
        <h2 class="testimonials__heading">What did the users have to say?</h2>
        <div class="testimonials__grid">
          <blockquote class="testimonial">
            <p class="testimonial__quote">
              I had actually been misdiagnosed as diabetic, but using the CGM, I
              could closely monitor and confirm my readings. My HbA1c came down
              to 5.8, and I was able to see that I was pre-diabetic due to
              insulin resistance, rather than diabetic. The visualization chart
              they provide is excellent and very helpful.
            </p>
            <footer class="testimonial__source">Someone looking for weight loss</footer>
          </blockquote>
          <blockquote class="testimonial">
            <p class="testimonial__quote">
              I have used both HealthifyMe and SugarFit CGMs, but I found
              GoodFlip's CGM to be far better than those two. The tracking chart
              generated in the GoodFlip app is very good. Unlike other systems,
              I don't have to repeatedly scan with NFC, and there are none of
              the Bluetooth disconnection issues. The product is really, really
              good. I have no complaints.
            </p>
            <footer class="testimonial__source">Pre-diabetic fitness enthusiast</footer>
          </blockquote>
        </div>
      </div>
    </section>

    <a class="crosslink" href={KAIRA_HREF}>
      <span class="crosslink__label">The food-logging AI has its own story</span>
      <span class="crosslink__cta">Read the Kaira case study<span aria-hidden="true"> →</span></span>
    </a>

    <footer class="cs__foot">
      <a class="cs__back" href="/#work">← Back to work</a>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  /* Light reading surface for the case study, matching the Kaira page. */
  body:has(.cs) {
    background-color: var(--surface);
    color: var(--ink);
  }
</style>

<style>
  /* ---- Shared case-study primitives (match the Kaira study) ---- */
  .cs {
    max-width: 64rem;
    margin: 0 auto;
    padding: var(--space-3xl) var(--space-xl) var(--space-3xl);
    color: var(--ink);
  }

  .cs__back {
    display: inline-block;
    font-size: var(--font-sm);
    font-weight: 500;
    color: var(--muted);
    transition: color 0.2s ease;
  }
  .cs__back:hover { color: var(--accent); }

  .cs__anchor { margin-top: var(--space-3xl); }

  .cs__title {
    margin-top: var(--space-sm);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  /* ---- Context: what GoodFlip is, what a CGM is ---- */
  .context {
    margin-top: var(--space-3xl);
  }
  .context__heading {
    font-size: var(--font-xl);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-lg);
  }
  .context__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
  }
  .context__col {
    padding: var(--space-xl);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .context__title {
    font-size: var(--font-md);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-xs);
  }
  .context__desc {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--ink);
  }
  .context__fig {
    margin: 0 0 var(--space-lg);
  }
  .context__img {
    display: block;
    width: 4.5rem;
    height: 4.5rem;
    object-fit: contain;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }
  @media (max-width: 48rem) {
    .context__grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }

  /* Highlights: the two headline numbers, right after the context section. */
  .highlights {
    margin-top: var(--space-3xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--hairline);
  }
  .highlights__heading {
    font-size: var(--font-xl);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-lg);
  }
  .highlights__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
  }
  .highlights__card {
    padding: var(--space-lg);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .highlights__value {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--accent);
  }
  .highlights__label {
    margin-top: var(--space-xs);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--ink);
  }

  /* ---- Experience the CGM: a plain full-bleed dark section ---- */
  .experience {
    box-sizing: border-box;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-top: var(--space-3xl);
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-3xl);
    background: var(--ink);
  }
  .experience__title {
    max-width: 60rem;
    margin: 0 auto;
    padding: 0 var(--space-xl);
    font-size: var(--font-xl);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .experience__content {
    max-width: 60rem;
    margin: var(--space-xl) auto 0;
    padding: 0 var(--space-xl);
  }
  .exp-card {
    padding: var(--space-2xl);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.04);
  }
  .exp-card__title {
    font-size: var(--font-xl);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: #fff;
    margin-bottom: var(--space-md);
  }
  .exp-card__intro {
    font-size: 1.125rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    max-width: 44rem;
  }
  .exp-card__img {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: var(--space-lg);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-md);
  }

  /* Block 1: the emphasised, spine-of-the-section card */
  .exp-card--hero {
    border: 2px solid var(--accent);
    background: rgba(231, 95, 56, 0.06);
  }
  .hero-split {
    display: flex;
    margin-bottom: var(--space-lg);
  }
  .hero-split__seg {
    flex: 1;
    padding: 0 var(--space-md);
    border-left: 1px solid rgba(255, 255, 255, 0.18);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .hero-split__seg:first-child {
    padding-left: 0;
    border-left: none;
  }
  .hero-split__seg strong {
    font-size: var(--font-base);
    font-weight: 700;
    color: var(--accent);
  }
  .hero-split__seg small {
    font-size: var(--font-xs);
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.6);
  }
  .hero-images {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }
  .hero-images__wide,
  .hero-images__narrow {
    display: block;
    height: auto;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-md);
  }
  .hero-images__wide { flex: 1.4; min-width: 0; }
  .hero-images__narrow { flex: 1; min-width: 0; }

  /* Block 2's highlighted, placeholder stat */
  .exp-card__stat {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px dashed rgba(255, 255, 255, 0.2);
  }
  .exp-card__stat-fig {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
  }
  .exp-card__stat-label {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.85);
  }

  @media (max-width: 40rem) {
    .hero-split {
      flex-direction: column;
      gap: var(--space-sm);
    }
    .hero-split__seg {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-xs);
      padding-left: 0;
      border-left: none;
    }
    .hero-images { flex-direction: column; }
  }

  .exp-proto {
    margin-top: var(--space-lg);
    aspect-ratio: 3 / 4;
    max-width: 24rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-md);
    background: rgba(0, 0, 0, 0.2);
  }
  .exp-proto iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .exp-steps {
    list-style: none;
    display: flex;
    align-items: flex-start;
    margin-top: var(--space-2xl);
  }
  .exp-step {
    position: relative;
    flex: 1;
    padding: 0 var(--space-md);
    text-align: center;
  }
  .exp-step:first-child { padding-left: 0; }
  .exp-step:last-child { padding-right: 0; }
  .exp-step::before {
    content: '';
    position: absolute;
    top: 1.125rem;
    left: -50%;
    width: 100%;
    height: 2px;
    background: rgba(255, 255, 255, 0.18);
  }
  .exp-step:first-child::before { display: none; }
  .exp-step__num {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    margin: 0 auto var(--space-sm);
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: var(--font-md);
  }
  .exp-step__text {
    font-size: 1.125rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
  }

  .exp-pointer {
    display: flex;
    justify-content: center;
    padding: var(--space-lg) 0;
    color: var(--accent);
  }
  .exp-pointer svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  @media (max-width: 40rem) {
    .exp-steps {
      flex-direction: column;
      gap: var(--space-lg);
    }
    .exp-step::before { display: none; }
    .exp-step { padding: 0; text-align: left; }
  }

  /* ---- Problem statement: the bright-orange full-bleed section ---- */
  .problem {
    box-sizing: border-box;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-top: 0;
    padding: var(--space-3xl) 0;
    background: var(--bg);
  }
  .problem__inner {
    max-width: 60rem;
    margin: 0 auto;
    padding: 0 var(--space-xl);
  }
  .problem__heading {
    font-size: var(--font-xl);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: #fff;
    margin-bottom: var(--space-lg);
  }
  .problem__text {
    max-width: 48rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
  }
  .problem__text + .problem__text {
    margin-top: var(--space-md);
  }
  .problem__text--highlight {
    font-size: var(--font-md);
    font-weight: 700;
    color: #fff;
  }

  /* Role block */
  .cs__divider {
    border: none;
    border-top: 1px solid var(--hairline);
    margin: var(--space-2xl) 0 0;
  }

  .cs__section-break {
    display: flex;
    align-items: center;
    gap: 0;
    margin: var(--space-3xl) 0;
  }
  .cs__section-break-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--hairline) 20%, var(--hairline) 80%, transparent);
  }
  .cs__section-break-dot {
    flex-shrink: 0;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
    margin: 0 var(--space-md);
  }

  /* Beats */
  .beat { margin-top: var(--space-3xl); }
  .beat__h {
    font-size: var(--font-xl);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-md);
  }
  .beat__sub {
    font-size: var(--font-md);
    font-weight: 700;
    margin-top: var(--space-xl);
    margin-bottom: var(--space-xs);
  }
  .beat p {
    max-width: 48rem;
    font-size: 1.125rem;
    line-height: 1.6;
    margin-top: var(--space-md);
  }
  .beat p:first-of-type { margin-top: 0; }
  .beat__lead {
    font-weight: 700;
    font-size: var(--font-lg) !important;
    line-height: 1.35;
  }

  /* Figures / placeholders */
  .shot { margin-top: var(--space-3xl); margin-bottom: var(--space-2xl); }
  .shot figcaption {
    margin-top: var(--space-sm);
    font-size: var(--font-sm);
    color: var(--muted);
    line-height: 1.5;
  }
  .cs__hero-img,
  .shot__img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
  }

  /* ---- Beat 2: Why CGM (3-beat narrative) ---- */
  .whycgm {
    margin-top: var(--space-3xl);
  }
  .whycgm__heading {
    font-size: var(--font-xl);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-lg);
  }

  .whycgm__setup {
    max-width: 44rem;
    text-align: left;
  }
  .whycgm__setup-text {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .whycgm__pivot {
    margin: var(--space-2xl) 0;
    padding: var(--space-2xl) 0;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--hairline);
  }
  .whycgm__pivot p {
    font-size: var(--font-lg);
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
    max-width: 48rem;
  }
  .whycgm__pivot p + p {
    margin-top: var(--space-md);
    color: var(--accent);
    font-weight: 700;
  }

  .whycgm__leadin {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: var(--space-lg);
    letter-spacing: 0.01em;
  }

  .whycgm__payoffs {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .payoff {
    padding: var(--space-lg);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    background: var(--surface);
    border-top: 3px solid rgba(0, 0, 0, 0.08);
  }
  .payoff--user {
    border-top-color: var(--accent);
    background: rgba(231, 95, 56, 0.03);
  }

  .payoff__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-bottom: var(--space-sm);
    color: var(--accent);
  }
  .payoff__icon svg {
    width: 100%;
    height: 100%;
  }
  .payoff__label {
    font-size: var(--font-base);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: var(--space-xs);
  }
  .payoff--user .payoff__label {
    color: var(--accent);
  }
  .payoff__body {
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--ink);
  }

  /* ---- Beat 3: metric table ---- */
  .mtable-wrap { margin-top: var(--space-xl); }
  .mtable-title {
    font-size: var(--font-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-sm);
  }
  .mtable {
    width: 100%;
    border-collapse: collapse;
    font-size: 1.125rem;
    line-height: 1.5;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .mtable th,
  .mtable td {
    text-align: left;
    padding: var(--space-md);
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }
  .mtable th {
    font-weight: 700;
    background: rgba(0, 0, 0, 0.03);
  }
  .mtable tr:last-child td { border-bottom: none; }
  .mtable__metric { font-weight: 700; white-space: nowrap; }
  .mtable__why { color: var(--muted); }
  .mtag {
    display: inline-block;
    font-size: var(--font-xs);
    font-weight: 700;
    padding: var(--space-2xs) var(--space-sm);
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .mtag--show { background: var(--accent); color: #fff; }
  .mtag--simplify { color: var(--accent); border: 1px solid var(--accent); }
  .mtag--withhold { color: var(--muted); border: 1px solid var(--hairline); }

  /* ---- Beat 4: process strip ---- */
  /* ---- Beat 5 / 7: decision + screen, caption items, fixes ---- */
  .decision {
    margin-top: var(--space-xl);
    display: grid;
    grid-template-columns: 1fr 16rem;
    gap: var(--space-xl);
    align-items: center;
  }
  .decision__kind {
    display: inline-block;
    font-size: var(--font-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-sm);
  }
  .decision__text p {
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .caption-item {
    margin-top: var(--space-xl);
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: var(--space-xl);
    align-items: center;
  }
  .caption-item__cap {
    font-size: var(--font-sm);
    line-height: 1.6;
    color: var(--muted);
  }

  /* Real screens inside decision / caption blocks */
  .decision__img,
  .caption-item__img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
  }

  /* Wide screens (tables, landscape cards) get their own full-width row. */
  .decision:has(.decision__img--wide),
  .caption-item:has(.caption-item__img--wide) {
    grid-template-columns: 1fr;
  }
  .decision__img--wide,
  .caption-item__img--wide {
    max-width: 42rem;
    margin-inline: auto;
  }

  /* Before / after pairs (Beat 7 fixes) — kept small and paired with an arrow */
  .beforeafter {
    margin-top: var(--space-md);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }
  .ba { margin: 0; }
  .ba__label {
    display: inline-block;
    font-size: var(--font-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-xs);
  }
  .ba__label--after { color: var(--accent); }
  .ba__img {
    display: block;
    width: 11rem;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
  }
  .ba__arrow {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    color: var(--accent);
  }
  .ba__arrow svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  @media (max-width: 28rem) {
    .ba__arrow svg { transform: rotate(90deg); }
  }

  /* Shipped prototypes (Figma embeds) at the top of Beat 5. */
  .protos {
    margin-top: var(--space-xl);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
  }
  .proto {
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .proto__label {
    font-size: var(--font-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-sm);
  }
  .proto__frame {
    aspect-ratio: 3 / 4;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    background: rgba(0, 0, 0, 0.03);
  }
  .proto__frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Beat 5: uniform, equally-weighted blocks aligned to the reading column. */
  .b5 {
    list-style: none;
    margin-top: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
  }
  .b5-item__title {
    font-size: var(--font-md);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-xs);
  }
  .b5-item__desc {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--ink);
    max-width: 40rem;
  }
  .b5-item__fig {
    margin: var(--space-lg) 0 0;
  }
  .b5-item__img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
  }
  .b5-item__fig--portrait .b5-item__img {
    max-width: 20rem;
  }

  /* Highlighted beat — error states */
  .b5-item--highlight {
    padding: var(--space-xl);
    border-left: 3px solid var(--accent);
    background: rgba(231, 95, 56, 0.03);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .b5-highlight {
    margin-top: var(--space-lg);
  }

  .b5-highlight .b5-item__fig {
    margin-top: var(--space-md);
  }

  .b5-highlight__tag {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .b5-highlight__tag--constraint {
    margin-top: var(--space-md);
  }

  .b5-highlight__pill {
    flex-shrink: 0;
    font-size: var(--font-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    background: var(--accent);
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  .b5-highlight__pill--muted {
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--hairline);
  }

  .b5-highlight__line {
    font-size: var(--font-sm);
    line-height: 1.5;
    color: var(--ink);
    font-style: italic;
  }

  .b5-highlight__line--muted {
    color: var(--muted);
    font-style: normal;
  }

  /* Thought bubbles: the two questions pulled out of the intro paragraph */
  .thought-bubbles {
    margin-top: var(--space-xl);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
  }
  .thought-bubble {
    position: relative;
    flex: 1;
    min-width: 14rem;
    padding: var(--space-lg);
    margin-bottom: var(--space-md);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    background: rgba(231, 95, 56, 0.03);
  }
  .thought-bubble p {
    font-size: 1.125rem;
    font-style: italic;
    line-height: 1.5;
    color: var(--ink);
  }
  .thought-bubble__tail {
    position: absolute;
    left: var(--space-lg);
    top: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    margin-top: 0.3rem;
  }
  .thought-bubble__tail i {
    display: block;
    border-radius: 50%;
    background: rgba(231, 95, 56, 0.15);
  }
  .thought-bubble__tail i:nth-child(1) { width: 0.6rem; height: 0.6rem; }
  .thought-bubble__tail i:nth-child(2) { width: 0.4rem; height: 0.4rem; margin-left: 0.3rem; }
  .thought-bubble__tail i:nth-child(3) { width: 0.25rem; height: 0.25rem; margin-left: 0.55rem; }

  /* Kaira's aims list + the Hooked Model diagram (Beat 8) */
  .hooked-aims {
    margin-top: var(--space-md);
    padding-left: 1.2em;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    max-width: 48rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--ink);
  }
  .hooked {
    margin-top: var(--space-2xl);
    display: flex;
    align-items: stretch;
    gap: var(--space-md);
  }
  .hooked__stage {
    flex: 1;
    padding: var(--space-lg);
    border: 1px solid var(--hairline);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .hooked__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-bottom: var(--space-sm);
    color: var(--accent);
  }
  .hooked__icon svg {
    width: 100%;
    height: 100%;
  }
  .hooked__title {
    font-size: var(--font-base);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: var(--space-xs);
  }
  .hooked__desc {
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .hooked__arrow {
    flex-shrink: 0;
    display: flex;
    align-items: center;
